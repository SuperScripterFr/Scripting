local Minus = MakeButton("- APS",70)
local Plus = MakeButton("+ APS",70)
local Mode = MakeButton("MODE",84)

--------------------------------------------------
-- UI UPDATE
--------------------------------------------------

local function UpdateUI()

	local tool = FindTool()
	local remote = FindRemote()

	Toggle.Text =
		CONFIG.Enabled and
		"AXE SMASH: ON" or
		"AXE SMASH: OFF"

	Status.Text =
		(tool and remote)
		and "READY"
		or "TOOL OR REMOTE MISSING"

	APSLabel.Text =
		"APS "..CONFIG.APS

	FiresLabel.Text =
		"Fires "..FireCount

	ToolLabel.Text =
		tool and "FOUND"
		or "MISSING"

	if CONFIG.Enabled then
		TweenService:Create(
			Toggle,
			TWEEN_FAST,
			{BackgroundColor3 = THEME.On}
		):Play()

		Glow.Transparency = .45
	else
		TweenService:Create(
			Toggle,
			TWEEN_FAST,
			{BackgroundColor3 = THEME.Button}
		):Play()

		Glow.Transparency = .72
	end

	Mode.Text =
		"MODE "..PRESETS[CurrentPreset].Name
end

--------------------------------------------------
-- BUTTONS
--------------------------------------------------

Toggle.MouseButton1Click:Connect(function()

	CONFIG.Enabled =
		not CONFIG.Enabled

	UpdateUI()

end)

Minus.MouseButton1Click:Connect(function()

	CONFIG.APS =
		math.max(
			10,
			CONFIG.APS - 10
		)

	UpdateUI()

end)

Plus.MouseButton1Click:Connect(function()

	CONFIG.APS =
		math.min(
			300,
			CONFIG.APS + 10
		)

	UpdateUI()

end)

Mode.MouseButton1Click:Connect(function()

	CurrentPreset += 1

	if CurrentPreset > #PRESETS then
		CurrentPreset = 1
	end

	CONFIG.APS =
		PRESETS[CurrentPreset].APS

	UpdateUI()

end)

--------------------------------------------------
-- KEYBIND
--------------------------------------------------

Track(
	UserInputService.InputBegan:Connect(
		function(input,gp)

			if gp then
				return
			end

			if input.KeyCode ==
				CONFIG.ToggleKey
			then

				CONFIG.Enabled =
					not CONFIG.Enabled

				UpdateUI()

			end
		end
	)
)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

Track(
	RunService.Heartbeat:Connect(
		function(dt)

			if not CONFIG.Enabled then
				return
			end

			Tokens += dt * CONFIG.APS

			local count = math.floor(Tokens)

			if count <= 0 then
				return
			end

			Tokens -= count

			for i=1,count do
				FireRemote()
			end

		end
	)
)

UpdateUI()

print("[RTX Axe Smash] Loaded")
