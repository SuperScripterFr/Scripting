-- RTX Axe Smash V1
-- Modern RTX Hub UI Foundation

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local TOOL_NAME = "Axe Smash"
local REMOTE_NAME = "Remote"

local CONFIG = {
	Enabled = false,
	APS = 80,
	ToggleKey = Enum.KeyCode.X
}

local PRESETS = {
	{ Name = "SAFE", APS = 35 },
	{ Name = "FAST", APS = 80 },
	{ Name = "MAX", APS = 150 }
}

local CurrentPreset = 2

--------------------------------------------------
-- THEME
--------------------------------------------------

local THEME = {
	Accent = Color3.fromRGB(255,0,0),
	Panel = Color3.fromRGB(18,18,24),
	Background = Color3.fromRGB(8,8,12),
	Button = Color3.fromRGB(0,0,0),
	Text = Color3.fromRGB(255,0,0),
	Muted = Color3.fromRGB(170,170,180),
	On = Color3.fromRGB(35,0,0)
}

local TWEEN_FAST =
	TweenInfo.new(
		0.16,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

--------------------------------------------------
-- CLEANUP
--------------------------------------------------

if _G.__RTXAxeCleanup then
	pcall(_G.__RTXAxeCleanup)
end

local Alive = true
local Connections = {}
local Gui

local function Track(c)
	table.insert(Connections,c)
	return c
end

local function Cleanup()
	Alive = false

	for _,c in ipairs(Connections) do
		if c and c.Connected then
			c:Disconnect()
		end
	end

	table.clear(Connections)

	if Gui then
		pcall(function()
			Gui:Destroy()
		end)
	end
end

_G.__RTXAxeCleanup = Cleanup

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function Round(obj,r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,r or 8)
	c.Parent = obj
end

local function Stroke(obj,t,a)
	local s = Instance.new("UIStroke")
	s.Color = THEME.Accent
	s.Thickness = t or 1
	s.Transparency = a or 0
	s.Parent = obj
	return s
end

local function FindTool()
	local char = LocalPlayer.Character

	if char then
		local t = char:FindFirstChild(TOOL_NAME)
		if t then return t end
	end

	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")

	if bp then
		local t = bp:FindFirstChild(TOOL_NAME)
		if t then return t end
	end

	return nil
end

local function FindRemote()
	local tool = FindTool()

	if not tool then
		return nil
	end

	return tool:FindFirstChild(REMOTE_NAME)
end

--------------------------------------------------
-- FIRING ENGINE
--------------------------------------------------

local Tokens = 0
local FireCount = 0

local function FireRemote()
	local remote = FindRemote()

	if not remote then
		return
	end

	local hit = Mouse.Hit

	pcall(function()
		remote:FireServer(hit)
	end)

	FireCount += 1
end

