-- ⚔️ HITBOX ASSIST (REAL IMPACT VERSION)

_G.HitboxSize = 8 -- keep reasonable (8–12 sweet spot)
_G.Enabled = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- cache
local targets = {}

-- 🔍 EXPANDED TARGET DATA (used by aura)
local function buildTargetList()

	local myChar = LocalPlayer.Character
	if not myChar then return end

	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	table.clear(targets)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then

			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")

			if hrp then
				local dist = (hrp.Position - myRoot.Position).Magnitude

				-- 🎯 EXPANDED RANGE USING HITBOX SIZE
				if dist <= (30 + _G.HitboxSize) then
					table.insert(targets, {
						char = char,
						hrp = hrp,
						size = _G.HitboxSize
					})
				end
			end
		end
	end
end

-- 🎯 EXPANDED HIT DETECTION (KEY PART)
local function getExpandedParts(target)

	local hrp = target.hrp
	if not hrp then return end

	-- simulate bigger hitbox WITHOUT changing physics
	local size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)

	return workspace:GetPartBoundsInBox(
		hrp.CFrame,
		size,
		nil
	)
end

-- 🔄 MAIN UPDATE
RunService.PreSimulation:Connect(function()
	if not _G.Enabled then return end
	buildTargetList()
end)

-- expose for aura use
_G.GetExpandedTargets = function()
	return targets
end

_G.GetExpandedParts = getExpandedParts

print("⚔️ Real Hitbox Assist Loaded")
