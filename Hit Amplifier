-- ==========================================================
-- ⚔️ ULTRA SMART HIT AMPLIFIER V3 - HYPER / NETWORK SAFE
-- ==========================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

if getgenv().SPT_Loaded and getgenv().SPT_Loaded["Hit Amplifier"] then
	print("⚔️ Hit Amplifier already loaded.")
	return
end
getgenv().SPT_Loaded = getgenv().SPT_Loaded or {}
getgenv().SPT_Loaded["Hit Amplifier"] = true

-- ============ CONFIG ============
getgenv().SPT_HitAmp = getgenv().SPT_HitAmp or {}
local G = getgenv().SPT_HitAmp

local HIT_RANGE    = Vector3.new(G.Range or 32, G.Range or 32, G.Range or 32)
local SCAN_RATE    = 1 / 60
local BURST_COUNT  = 3
local ACTIVE       = true
local TOGGLE_KEY   = Enum.KeyCode.H

-- ============ UI ============
local gui = Instance.new("ScreenGui")
gui.Name = "HitAmpUI"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local label = Instance.new("TextLabel", gui)
label.Size = UDim2.fromOffset(280, 34)
label.Position = UDim2.new(0.5, -140, 0.16, 0)
label.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
label.BackgroundTransparency = 0.2
label.TextColor3 = Color3.fromRGB(255, 80, 80)
label.TextScaled = true
label.Font = Enum.Font.GothamBold

local function updateLabel()
	label.Text = ACTIVE and "⚔️ Hit Amplifier: ACTIVE [H]" or "⚔️ Hit Amplifier: OFF [H]"
end
updateLabel()

-- ============ STATE / TOOL CACHE ============
local accumulator = 0
local tools = {}

local function rebuildTools()
	for i = #tools, 1, -1 do
		if not tools[i] or not tools[i].Parent then table.remove(tools, i) end
	end
	local char = LocalPlayer.Character
	if not char then return end
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and not table.find(tools, t) then
			tools[#tools + 1] = t
		end
	end
end

local function refreshSoon()
	task.defer(rebuildTools)
end

local function onCharTool(o)
	if o:IsA("Tool") then refreshSoon() end
end

LocalPlayer.CharacterAdded:Connect(function(char)
	rebuildTools()
	char.ChildAdded:Connect(onCharTool)
	char.ChildRemoved:Connect(onCharTool)
end)

if LocalPlayer.Character then
	LocalPlayer.Character.ChildAdded:Connect(onCharTool)
	LocalPlayer.Character.ChildRemoved:Connect(onCharTool)
end
rebuildTools()

-- ============ PULSE ============
local function pulse()
	for i = 1, #tools do
		local t = tools[i]
		if t and t.Parent then
			for _ = 1, BURST_COUNT do
				pcall(t.Activate, t)
			end
			local rem = t:FindFirstChild("FightEvent")
			if rem then
				pcall(rem.FireServer, rem)
			end
		end
	end
end

-- ============ TARGET SCAN ============
local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Blacklist

-- ============ ENGINE ============
RunService.Stepped:Connect(function(dt)
	if not ACTIVE then return end
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	accumulator += dt
	if accumulator < SCAN_RATE then return end
	accumulator = 0

	overlapParams.FilterDescendantsInstances = { char }

	local parts = workspace:GetPartBoundsInBox(CFrame.new(hrp.Position), HIT_RANGE, overlapParams)

	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model then
			local hum = model:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				pulse()
				break
			end
		end
	end
end)

-- ============ TOGGLE ============
UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == TOGGLE_KEY then
		ACTIVE = not ACTIVE
		updateLabel()
	end
end)

print("⚔️ Ultra Smart Hit Amplifier V3 Loaded")
