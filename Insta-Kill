--// ⚡ RTX BURST AURA V2
--// Detection Burst Engine
--// Optimized for consistency + low hitching

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local RANGE = 30
local RANGE_SQ = RANGE * RANGE

-- adaptive burst
local TOUCHES_PER_PART = 3
local REMOTES_PER_TOOL = 3

-- update rates
local TARGET_REFRESH = 0
local IDLE_INTERVAL = 0
local ACTIVE_INTERVAL = 0

--------------------------------------------------
-- INTERNALS
--------------------------------------------------

local toolCache = {}
local touchCache = {}
local remoteCache = {}

local currentTarget
local currentTargetHum
local currentTargetParts

local lastTargetUpdate = 0
local lastAttack = 0

local activeState = false

--------------------------------------------------
-- PRIORITY PARTS
--------------------------------------------------

local PRIORITY_PARTS = {
	"HumanoidRootPart",
	"Torso",
	"UpperTorso",
}

--------------------------------------------------
-- FAST REFERENCES
--------------------------------------------------

local localCharacter
local localRoot

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function bindCharacter(char)

	localCharacter = char
	localRoot = nil

	if not char then
		return
	end

	localRoot = char:FindFirstChild("HumanoidRootPart")

	if not localRoot then
		task.spawn(function()

			local hrp = char:WaitForChild("HumanoidRootPart",5)

			if localCharacter == char then
				localRoot = hrp
			end
		end)
	end
end

if LocalPlayer.Character then
	bindCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(bindCharacter)

--------------------------------------------------
-- TOOL CACHE
--------------------------------------------------

local function cacheTools()

	table.clear(toolCache)
	table.clear(touchCache)
	table.clear(remoteCache)

	local char = localCharacter
	if not char then
		return
	end

	for _,obj in ipairs(char:GetChildren()) do

		if obj:IsA("Tool") then

			toolCache[#toolCache+1] = obj

			------------------------------------------------
			-- TOUCH PART
			------------------------------------------------

			local touch = obj:FindFirstChildWhichIsA(
				"TouchTransmitter",
				true
			)

			if touch then

				local part = touch.Parent

				if part and part:IsA("BasePart") then
					touchCache[obj] = part
				end
			end

			------------------------------------------------
			-- REMOTE
			------------------------------------------------

			local remote = obj:FindFirstChild("FightEvent")

			if remote then
				remoteCache[obj] = remote
			end
		end
	end
end

--------------------------------------------------
-- TOOL TRACKING
--------------------------------------------------

local function hookCharacter(char)

	cacheTools()

	char.ChildAdded:Connect(function(obj)

		if obj:IsA("Tool") then
			task.defer(cacheTools)
		end
	end)

	char.ChildRemoved:Connect(function(obj)

		if obj:IsA("Tool") then
			task.defer(cacheTools)
		end
	end)
end

if LocalPlayer.Character then
	hookCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(hookCharacter)

--------------------------------------------------
-- TARGET PART CACHE
--------------------------------------------------

local function buildParts(char)

	local t = table.create(3)

	for i = 1,#PRIORITY_PARTS do

		local part = char:FindFirstChild(PRIORITY_PARTS[i])

		if part then
			t[#t+1] = part
		end
	end

	return t
end

--------------------------------------------------
-- TARGETING
--------------------------------------------------

local function updateTarget()

	local now = os.clock()

	if now - lastTargetUpdate < TARGET_REFRESH then
		return
	end

	lastTargetUpdate = now

	local myRoot = localRoot

	if not myRoot then
		currentTarget = nil
		return
	end

	local bestCharacter
	local bestHum
	local bestDist = RANGE_SQ

	local myPos = myRoot.Position

	for _,plr in ipairs(Players:GetPlayers()) do

		if plr ~= LocalPlayer then

			local char = plr.Character

			if char then

				local hum = char:FindFirstChildOfClass("Humanoid")

				if hum and hum.Health > 0 then

					local root = char:FindFirstChild("HumanoidRootPart")

					if root then

						local delta = root.Position - myPos

						local distSq =
							delta.X*delta.X +
							delta.Y*delta.Y +
							delta.Z*delta.Z

						if distSq < bestDist then

							bestDist = distSq
							bestCharacter = char
							bestHum = hum
						end
					end
				end
			end
		end
	end

	currentTarget = bestCharacter
	currentTargetHum = bestHum

	if bestCharacter then
		currentTargetParts = buildParts(bestCharacter)
	else
		currentTargetParts = nil
	end

	activeState = bestCharacter ~= nil
end

--------------------------------------------------
-- TOUCH ENGINE
--------------------------------------------------

local function hitTarget()

	if not currentTarget then
		return
	end

	if not currentTargetHum then
		return
	end

	if currentTargetHum.Health <= 0 then
		return
	end

	local targetParts = currentTargetParts

	if not targetParts then
		return
	end

	------------------------------------------------
	-- TOOL LOOP
	------------------------------------------------

	for i = 1,#toolCache do

		local tool = toolCache[i]

		------------------------------------------------
		-- TOUCHES
		------------------------------------------------

		local touchPart = touchCache[tool]

		if touchPart then

			for p = 1,#targetParts do

				local targetPart = targetParts[p]

				for t = 1,TOUCHES_PER_PART do

					firetouchinterest(
						touchPart,
						targetPart,
						0
					)

					firetouchinterest(
						touchPart,
						targetPart,
						1
					)
				end
			end
		end

		------------------------------------------------
		-- REMOTES
		------------------------------------------------

		local remote = remoteCache[tool]

		if remote then

			for r = 1,REMOTES_PER_TOOL do
				remote:FireServer()
			end
		end
	end
end

--------------------------------------------------
-- MAIN ENGINE
--------------------------------------------------

RunService.PreSimulation:Connect(function()

	updateTarget()

	------------------------------------------------
	-- IDLE MODE
	------------------------------------------------

	local interval = activeState
		and ACTIVE_INTERVAL
		or IDLE_INTERVAL

	local now = os.clock()

	if now - lastAttack < interval then
		return
	end

	lastAttack = now

	------------------------------------------------
	-- ATTACK
	------------------------------------------------

	if activeState then
		hitTarget()
	end
end)

print("⚡ RTX Burst Aura V2 Loaded")
