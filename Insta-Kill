-- ⚡ RTX BURST AURA V1
-- Optimized Burst Combat Engine

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local RANGE = 30

local AURA_SIZE = Vector3.new(30,30,30)

-- burst structure
local BURST_COUNT = 3
local TOUCHES_PER_PART = 3
local REMOTES_PER_TOOL = 3

-- timing
local BURST_INTERVAL = 1 / 20

--------------------------------------------------
-- INTERNALS
--------------------------------------------------

local auraParams = OverlapParams.new()
auraParams.FilterType = Enum.RaycastFilterType.Include

local toolCache = {}
local touchCache = {}

local cachedTarget = nil
local lastTargetUpdate = 0

local lastBurst = 0

--------------------------------------------------
-- PRIORITY PARTS
--------------------------------------------------

local PRIORITY_PARTS = {
	"HumanoidRootPart",
	"UpperTorso",
	"Torso",
	"Head"
}

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function getCharacter(plr)
	return plr and plr.Character
end

local function getRoot(plr)
	local char = getCharacter(plr)
	return char and char:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------
-- TOOL CACHE
--------------------------------------------------

local function cacheTools()

	table.clear(toolCache)
	table.clear(touchCache)

	local char = LocalPlayer.Character
	if not char then
		return
	end

	for _,obj in ipairs(char:GetChildren()) do

		if obj:IsA("Tool") then

			table.insert(toolCache,obj)

			local touch = obj:FindFirstChildWhichIsA("TouchTransmitter",true)

			if touch and touch.Parent:IsA("BasePart") then
				touchCache[obj] = touch.Parent
			end
		end
	end
end

--------------------------------------------------
-- CHARACTER HOOK
--------------------------------------------------

local function bindCharacter(char)

	cacheTools()

	char.ChildAdded:Connect(function(obj)
		if obj:IsA("Tool") then
			task.defer(cacheTools)
		end
	end)

	char.ChildRemoved:Connect(function(obj)
		if obj:IsA("Tool") then
			task.defer(cacheTools)
		end
	end)
end

if LocalPlayer.Character then
	bindCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(bindCharacter)

--------------------------------------------------
-- TARGETING
--------------------------------------------------

local function getTarget()

	local now = os.clock()

	if now - lastTargetUpdate < 0.08 then
		return cachedTarget
	end

	lastTargetUpdate = now

	local myRoot = getRoot(LocalPlayer)

	if not myRoot then
		return nil
	end

	local best
	local bestDist = RANGE

	for _,plr in ipairs(Players:GetPlayers()) do

		if plr ~= LocalPlayer then

			local root = getRoot(plr)

			if root then

				local dist = (root.Position - myRoot.Position).Magnitude

				if dist < bestDist then
					bestDist = dist
					best = plr.Character
				end
			end
		end
	end

	cachedTarget = best

	return best
end

--------------------------------------------------
-- PART COLLECTION
--------------------------------------------------

local function collectPriorityParts(char)

	local t = {}

	for _,name in ipairs(PRIORITY_PARTS) do

		local part = char:FindFirstChild(name)

		if part and part:IsA("BasePart") then
			table.insert(t,part)
		end
	end

	return t
end

--------------------------------------------------
-- TOUCH
--------------------------------------------------

local function touch(toolPart,targetPart)

	for i = 1, TOUCHES_PER_PART do

		firetouchinterest(toolPart,targetPart,0)
		firetouchinterest(toolPart,targetPart,1)

	end
end

--------------------------------------------------
-- REMOTE BURST
--------------------------------------------------

local function remoteBurst(tool)

	local remote = tool:FindFirstChild("FightEvent")

	if not remote then
		return
	end

	for i = 1, REMOTES_PER_TOOL do

		pcall(function()
			remote:FireServer()
		end)
	end
end

--------------------------------------------------
-- MAIN ENGINE
--------------------------------------------------

RunService.PreSimulation:Connect(function()

	local now = os.clock()

	if now - lastBurst < BURST_INTERVAL then
		return
	end

	lastBurst = now

	local char = LocalPlayer.Character

	if not char then
		return
	end

	if #toolCache == 0 then
		return
	end

	local target = getTarget()

	if not target then
		return
	end

	------------------------------------------------
	-- PRIORITY PARTS
	------------------------------------------------

	local targetParts = collectPriorityParts(target)

	if #targetParts == 0 then
		return
	end

	------------------------------------------------
	-- BURST CYCLE
	------------------------------------------------

	for burst = 1, BURST_COUNT do

		for _,tool in ipairs(toolCache) do

			local touchPart = touchCache[tool]

			if touchPart then

				for _,part in ipairs(targetParts) do
					touch(touchPart,part)
				end
			end

			remoteBurst(tool)
		end

		-- micro frame sync
		RunService.PostSimulation:Wait()
	end
end)

print("⚡ RTX Burst Aura Loaded")
