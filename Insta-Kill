-- ⚡ ULTRA AURA V3 (SPAWN KILL OPTIMIZED)

local RANGE = 30
local AURA_SIZE = Vector3.new(30,30,30)

local TOUCH_RATE = 1/25
local REMOTE_RATE = 1/25

local BURST_WINDOW = 0.25 -- 🔥 CRITICAL

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local lastTouch = 0
local lastRemote = 0

local spawnTime = 0

local auraParams = OverlapParams.new()
auraParams.FilterType = Enum.RaycastFilterType.Include

-- =========================

local function getHRP(plr)
	local c = plr.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function getTarget()
	local myRoot = getHRP(LocalPlayer)
	if not myRoot then return end

	local best, dist = nil, RANGE

	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local r = getHRP(p)
			if r then
				local d = (r.Position - myRoot.Position).Magnitude
				if d < dist then
					dist = d
					best = p.Character
				end
			end
		end
	end

	return best
end

local function getTouchPart(tool)
	local t = tool:FindFirstChildWhichIsA("TouchTransmitter", true)
	return t and t.Parent
end

local function equipAll(char)
	for _,t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") and t.Parent ~= char then
			t.Parent = char
		end
	end
end

-- =========================
-- ⚡ PRE STEP (EQUIP FIRST)
-- =========================

RunService.PreSimulation:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end

	equipAll(char)
end)

-- =========================
-- ⚡ POST STEP (DAMAGE CORE)
-- =========================

RunService.PostSimulation:Connect(function()

	local char = LocalPlayer.Character
	if not char then return end

	local target = getTarget()
	if not target then return end

	auraParams.FilterDescendantsInstances = {target}

	local now = os.clock()

	local isSpawnBurst = (now - spawnTime) <= BURST_WINDOW

	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then

			local fightEvent = tool:FindFirstChild("FightEvent")
			local touch = getTouchPart(tool)

			-- 🔥 SPAWN BURST (IGNORES RATE LIMIT)
			if isSpawnBurst then

				if fightEvent then
					fightEvent:FireServer()
					fightEvent:FireServer()
				end

				if touch then
					local parts = workspace:GetPartBoundsInBox(
						touch.CFrame,
						touch.Size + AURA_SIZE,
						auraParams
					)

					for _, part in ipairs(parts) do
						firetouchinterest(touch, part, 0)
						firetouchinterest(touch, part, 1)
					end
				end

			else
				-- NORMAL MODE

				if now - lastRemote >= REMOTE_RATE then
					if fightEvent then
						fightEvent:FireServer()
					end
				end

				if now - lastTouch >= TOUCH_RATE then
					if touch then
						local parts = workspace:GetPartBoundsInBox(
							touch.CFrame,
							touch.Size + AURA_SIZE,
							auraParams
						)

						for _, part in ipairs(parts) do
							firetouchinterest(touch, part, 0)
							firetouchinterest(touch, part, 1)
						end
					end
				end
			end

		end
	end

	if not isSpawnBurst then
		if now - lastRemote >= REMOTE_RATE then
			lastRemote = now
		end
		if now - lastTouch >= TOUCH_RATE then
			lastTouch = now
		end
	end

end)

-- =========================
-- ⚡ RESPAWN DETECTION (EARLY)
-- =========================

task.spawn(function()
	local lastChar

	while true do
		local char = LocalPlayer.Character
		if char and char ~= lastChar then
			lastChar = char
			spawnTime = os.clock() -- 🔥 START BURST WINDOW
		end
		RunService.PreSimulation:Wait()
	end
end)

print("⚡ Ultra Aura V3 Loaded")
