-- ⚡ ULTRA STABLE FRAME AURA (REAL OPTIMIZATION)

local RANGE = 15
local AURA_SIZE = Vector3.new(15,15,15)

local TOUCH_RATE = 32.5
local REMOTE_RATE = 75
local TOUCH_BURST = 1.5

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- timing
local lastTouch = 0
local lastRemote = 0

-- cache
local cachedTarget = nil
local lastTargetUpdate = 0

local auraParams = OverlapParams.new()
auraParams.FilterType = Enum.RaycastFilterType.Include

-- =========================
-- HELPERS
-- =========================

local function getHRP(plr)
	local c = plr.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function getTarget()
	local now = os.clock()

	-- update target every 0.1s (huge perf win)
	if now - lastTargetUpdate < 0.1 then
		return cachedTarget
	end

	lastTargetUpdate = now

	local myRoot = getHRP(LocalPlayer)
	if not myRoot then return end

	local best, dist = nil, RANGE

	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local r = getHRP(p)
			if r then
				local d = (r.Position - myRoot.Position).Magnitude
				if d < dist then
					dist = d
					best = p.Character
				end
			end
		end
	end

	cachedTarget = best
	return best
end

local function getTouchPart(tool)
	local t = tool:FindFirstChildWhichIsA("TouchTransmitter", true)
	return t and t.Parent
end

local function tap(part, enemyPart)
	for i = 1, TOUCH_BURST do
		firetouchinterest(part, enemyPart, 0)
		firetouchinterest(part, enemyPart, 1)
	end
end

-- =========================
-- PRE STEP (equip + prep)
-- =========================

RunService.PreSimulation:Connect(function()

	local char = LocalPlayer.Character
	if not char then return end

	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") and tool.Parent ~= char then
			tool.Parent = char
		end
	end

end)

-- ⚔️ FUNCTIONAL HITBOX EXPANDER

_G.HitboxSize = 10
_G.Enabled = true

local hitboxes = {}

-- CREATE HITBOX (QUERY-BASED, NOT PHYSICS)
local function createHitbox(char)
	if not char then return end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	if hitboxes[char] then return end

	local box = Instance.new("Part")
	box.Name = "AuraHitbox"
	box.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)

	box.Transparency = 1
	box.Anchored = true -- 🔥 KEY: no physics at all
	box.CanCollide = false
	box.CanTouch = false -- we DO NOT rely on .Touched
	box.CanQuery = true -- 🔥 THIS is what matters

	box.CFrame = hrp.CFrame
	box.Parent = workspace -- not inside character (important)

	hitboxes[char] = {
		box = box,
		hrp = hrp
	}
end

-- REMOVE
local function removeHitbox(char)
	if hitboxes[char] then
		hitboxes[char].box:Destroy()
		hitboxes[char] = nil
	end
end

-- TRACK PLAYERS
local function handlePlayer(player)
	if player == LocalPlayer then return end

	player.CharacterAdded:Connect(function(char)
		task.wait(0.05)
		if _G.Enabled then
			createHitbox(char)
		end
	end)

	if player.Character then
		createHitbox(player.Character)
	end
end

for _,p in ipairs(Players:GetPlayers()) do
	handlePlayer(p)
end

Players.PlayerAdded:Connect(handlePlayer)

-- 🔄 SYNC LOOP (VERY LIGHT)
RunService.PreSimulation:Connect(function()

	if not _G.Enabled then return end

	for char,data in pairs(hitboxes) do
		if char.Parent and data.hrp then
			data.box.CFrame = data.hrp.CFrame

			-- dynamic resize (cheap)
			local targetSize = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
			if data.box.Size ~= targetSize then
				data.box.Size = targetSize
			end
		end
	end

end)

print("⚔️ Functional Hitbox Loaded (Query-Based)")

-- =========================
-- POST STEP (ACTUAL DAMAGE)
-- =========================
RunService.PostSimulation:Connect(function()

	local char = LocalPlayer.Character
	if not char then return end

	local target = getTarget()
	if not target then return end

	local partsToScan = {}

	-- include real character
	table.insert(partsToScan, target)
	
	-- include expanded hitbox
	local hb = hitboxes[target]
	if hb then
		table.insert(partsToScan, hb.box)
	end
	
	auraParams.FilterDescendantsInstances = partsToScan

	local now = os.clock()

	-- 🔹 GET PARTS ONCE (IMPORTANT)
	local sampleTool = nil
	for _,t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			sampleTool = t
			break
		end
	end

	if not sampleTool then return end

	local touchPart = getTouchPart(sampleTool)
	if not touchPart then return end

	local parts = workspace:GetPartBoundsInBox(
		touchPart.CFrame,
		touchPart.Size + AURA_SIZE,
		auraParams
	)

	-- 🔹 APPLY TO ALL TOOLS
	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then

			-- REMOTE (slower, reliable)
			if now - lastRemote >= REMOTE_RATE then
				local fightEvent = tool:FindFirstChild("FightEvent")
				if fightEvent then
					pcall(function()
						fightEvent:FireServer()
					end)
				end
			end

			-- TOUCH (faster)
			if now - lastTouch >= TOUCH_RATE then
				local tp = getTouchPart(tool)
				if tp then
					for _, part in ipairs(parts) do
						tap(tp, part)
					end
				end
			end

		end
	end

	if now - lastRemote >= REMOTE_RATE then
		lastRemote = now
	end

	if now - lastTouch >= TOUCH_RATE then
		lastTouch = now
	end
end)

print("⚡ Ultra Aura Loaded")
