-- ⚡ RTX BURST AURA V4 (EVENT-DRIVEN + ADAPTIVE)

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local RANGE = 30
local RANGE_SQ = RANGE * RANGE

local TOUCHES_PER_PART = 2
local REMOTES_PER_TOOL = 2

local TARGET_REFRESH = 0.08
local ATTACK_INTERVAL = 0.06

-- 🔥 NEW: equip burst tuning
local EQUIP_BURST_MIN = 2
local EQUIP_BURST_MAX = 4

--------------------------------------------------
-- STATE
--------------------------------------------------

local toolCache = {}
local touchCache = {}
local remoteCache = {}

local localCharacter
local localRoot

local currentTarget
local currentTargetHum
local currentTargetParts

local lastTargetUpdate = 0
local lastAttack = 0

local equippedTools = {}

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function bindCharacter(char)
	localCharacter = char
	localRoot = char and char:FindFirstChild("HumanoidRootPart")

	if char and not localRoot then
		localRoot = char:WaitForChild("HumanoidRootPart", 5)
	end

	-- 🔥 reset equip state
	table.clear(equippedTools)
end

LocalPlayer.CharacterAdded:Connect(bindCharacter)
if LocalPlayer.Character then
	bindCharacter(LocalPlayer.Character)
end

--------------------------------------------------
-- TOOL CACHE (ENHANCED)
--------------------------------------------------

local function cacheTools()
	table.clear(toolCache)
	table.clear(touchCache)
	table.clear(remoteCache)

	local char = localCharacter
	if not char then return end

	for _, obj in ipairs(char:GetChildren()) do
		if obj:IsA("Tool") then
			table.insert(toolCache, obj)

			local touch = obj:FindFirstChildWhichIsA("TouchTransmitter", true)
			if touch and touch.Parent and touch.Parent:IsA("BasePart") then
				touchCache[obj] = touch.Parent
			end

			local remote = obj:FindFirstChild("FightEvent")
			if remote and remote:IsA("RemoteEvent") then
				remoteCache[obj] = remote
			end
		end
	end
end

--------------------------------------------------
-- TOOL TRACKING + EQUIP BURST (NEW CORE FEATURE)
--------------------------------------------------

local function hookCharacter(char)

	cacheTools()

	char.ChildAdded:Connect(function(obj)
		if obj:IsA("Tool") then

			task.wait(0.03)
			cacheTools()

			-- 🔥 EQUIP BURST (NEW)
			local remote = obj:FindFirstChild("FightEvent")
			if remote and remote:IsA("RemoteEvent") then

				local burst = math.random(EQUIP_BURST_MIN, EQUIP_BURST_MAX)

				task.spawn(function()
					for _ = 1, burst do
						if remote.Parent then
							remote:FireServer()
						end
						RunService.Heartbeat:Wait()
					end
				end)
			end
		end
	end)

	char.ChildRemoved:Connect(function(obj)
		if obj:IsA("Tool") then
			task.defer(cacheTools)
		end
	end)
end

if LocalPlayer.Character then
	hookCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(hookCharacter)

--------------------------------------------------
-- TARGET PARTS
--------------------------------------------------

local PRIORITY_PARTS = {
	"HumanoidRootPart",
	"UpperTorso",
	"Torso",
}

local function buildParts(char)
	local t = {}

	for _, name in ipairs(PRIORITY_PARTS) do
		local part = char:FindFirstChild(name)
		if part then
			table.insert(t, part)
		end
	end

	return t
end

--------------------------------------------------
-- TARGET UPDATE
--------------------------------------------------

local function updateTarget()

	local now = os.clock()
	if now - lastTargetUpdate < TARGET_REFRESH then return end
	lastTargetUpdate = now

	local root = localRoot
	if not root then
		currentTarget = nil
		return
	end

	local best, bestHum
	local bestDist = RANGE_SQ
	local myPos = root.Position

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then

			local char = plr.Character
			local hum = char:FindFirstChildOfClass("Humanoid")
			local r = char:FindFirstChild("HumanoidRootPart")

			if hum and r and hum.Health > 0 then

				local d = r.Position - myPos
				local dist = d.X*d.X + d.Y*d.Y + d.Z*d.Z

				if dist < bestDist then
					bestDist = dist
					best = char
					bestHum = hum
				end
			end
		end
	end

	currentTarget = best
	currentTargetHum = bestHum

	if best then
		currentTargetParts = buildParts(best)
	else
		currentTargetParts = nil
	end
end

--------------------------------------------------
-- HIT ENGINE (SYNCHRONIZED + DEAD SAFE)
--------------------------------------------------

local function hitTarget()

	if not currentTarget or not currentTargetHum then return end
	if currentTargetHum.Health <= 0 then return end
	if not currentTargetParts then return end

	for _, tool in ipairs(toolCache) do

		local touchPart = touchCache[tool]
		local remote = remoteCache[tool]

		-- 🔥 TOUCH SYSTEM
		if touchPart then
			for _, targetPart in ipairs(currentTargetParts) do
				for _ = 1, TOUCHES_PER_PART do
					firetouchinterest(touchPart, targetPart, 0)
					firetouchinterest(touchPart, targetPart, 1)
				end
			end
		end

		-- 🔥 REMOTE SYSTEM (SYNCED BURST)
		if remote and remote.Parent then
			for _ = 1, REMOTES_PER_TOOL do
				remote:FireServer()
			end
		end
	end
end

--------------------------------------------------
-- MAIN LOOP (SMART GATING)
--------------------------------------------------

RunService.PreSimulation:Connect(function()

	updateTarget()

	local now = os.clock()

	if now - lastAttack < ATTACK_INTERVAL then return end

	-- 🔥 STOP SPAM IF NO TARGET
	if not currentTarget or not currentTargetHum or currentTargetHum.Health <= 0 then
		return
	end

	lastAttack = now

	hitTarget()
end)

print("⚡ RTX Burst Aura V4 Loaded (Equip Burst + Synchronized)")