-- ⚡ SINGLE TARGET FOCUSED AURA

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- CONFIG
local RANGE = 30
local TOUCH_BURST = 2
local AURA_RATE = 1/250

local lastAura = 0

-- HELPERS
local function getHRP(plr)
	local c = plr.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- ✅ FIND BEST TARGET (nearest)
local function getBestTarget()
	local myRoot = getHRP(LocalPlayer)
	if not myRoot then return end

	local bestTarget = nil
	local bestDist = RANGE

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local r = getHRP(p)
			if r then
				local dist = (r.Position - myRoot.Position).Magnitude
				if dist < bestDist then
					bestDist = dist
					bestTarget = r
				end
			end
		end
	end

	return bestTarget
end

-- ✅ CLEAN TAP (no redundant spam)
local function tap(toolPart, enemyPart)
	for i = 1, TOUCH_BURST do
		firetouchinterest(toolPart, enemyPart, 0)
		firetouchinterest(toolPart, enemyPart, 1)
	end
end

-- ⚡ CORE LOOP
RunService.Heartbeat:Connect(function()

	local char = LocalPlayer.Character
	if not char then return end

	local now = os.clock()
	if now - lastAura < AURA_RATE then return end
	lastAura = now

	local targetHRP = getBestTarget()
	if not targetHRP then return end

	-- ⚡ stabilization (VERY IMPORTANT)
	RunService.Heartbeat:Wait()

	-- ✅ ALL TOOLS → ONE TARGET HRP
	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then

			if tool.Parent ~= char then
				tool.Parent = char
			end

			local touch = tool:FindFirstChildWhichIsA("TouchTransmitter", true)
			touch = touch and touch.Parent

			if touch then
				tap(touch, targetHRP)
			end
		end
	end

end)

print("⚡ Focused Aura Loaded")
