-- ⚡ FOCUSED AURA (HITBOX ENHANCED)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- CONFIG
local RANGE = 30
local TOUCH_BURST = 2
local AURA_RATE = 1/25

local lastAura = 0

-- HELPERS
local function getHRP(plr)
	local c = plr.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

-- 🎯 BEST TARGET (same logic, keep it)
local function getBestTargetChar()
	local myRoot = getHRP(LocalPlayer)
	if not myRoot then return end

	local bestChar = nil
	local bestDist = RANGE

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local r = getHRP(p)
			if r then
				local dist = (r.Position - myRoot.Position).Magnitude
				if dist < bestDist then
					bestDist = dist
					bestChar = p.Character
				end
			end
		end
	end

	return bestChar
end

local function tap(toolPart, enemyPart)
	for i = 1, TOUCH_BURST do
		firetouchinterest(toolPart, enemyPart, 0)
		firetouchinterest(toolPart, enemyPart, 1)
	end
end

-- ⚡ CORE LOOP
RunService.Heartbeat:Connect(function()

	local char = LocalPlayer.Character
	if not char then return end

	local now = os.clock()
	if now - lastAura < AURA_RATE then return end
	lastAura = now

	local targetChar = getBestTargetChar()
	if not targetChar then return end

	-- 🔥 USE HITBOX ENGINE IF AVAILABLE
	local partsToHit = nil

	if _G.GetExpandedParts then
		partsToHit = _G.GetExpandedParts(targetChar)
	end

	-- fallback if hitbox not loaded
	if not partsToHit or #partsToHit == 0 then
		local hrp = targetChar:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		partsToHit = {hrp}
	end

	-- ⚡ stabilization (important)
	RunService.Heartbeat:Wait()

	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then

			if tool.Parent ~= char then
				tool.Parent = char
			end

			local touch = tool:FindFirstChildWhichIsA("TouchTransmitter", true)
			touch = touch and touch.Parent

			if touch then
				for _, part in ipairs(partsToHit) do
					tap(touch, part)
				end
			end
		end
	end

end)

print("⚡ Focused Aura (Hitbox Enhanced) Loaded")
