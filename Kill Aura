-- ⚡ FRAME SYNCED MULTI TARGET KILL AURA

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- CONFIG
local RANGE = 30
local AURA_SIZE = Vector3.new(30,30,30)

local TOUCH_BURST = 2

local lastAura = 0
local AURA_RATE = 1/30 -- 30Hz max

-- STATE
local targetCache = {}
local auraParams = OverlapParams.new()
auraParams.FilterType = Enum.RaycastFilterType.Include

-- helpers
local function getHRP(plr)
	local c = plr.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function buildTargets()

	local t = {}

	for name in pairs(bringTargets) do
		local p = Players:FindFirstChild(name)
		if p and p.Character then
			table.insert(t, p.Character)
		end
	end

	return t
end

local function tap(part, enemyPart)
	pcall(firetouchinterest, part, enemyPart, 0)
	pcall(firetouchinterest, part, enemyPart, 1)
end

RunService.PreSimulation:Connect(function()

	local STABILIZE_DELAY = true

	local char = LocalPlayer.Character
	if not char then return end

	targetCache = buildTargets()
	if #targetCache == 0 then return end
	-- after building targets
	if STABILIZE_DELAY then
		RunService.PostSimulation:Wait()
	end

	auraParams.FilterDescendantsInstances = targetCache

	local now = os.clock()
	if now - lastAura < AURA_RATE then return end
	lastAura = now

	for _,tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then

			if tool.Parent ~= char then
				tool.Parent = char
			end

			local touchPart = tool:FindFirstChildWhichIsA("TouchTransmitter",true)
			touchPart = touchPart and touchPart.Parent

			-- physical aura strike
			if touchPart then

				local parts = workspace:GetPartBoundsInBox(
					touchPart.CFrame,
					touchPart.Size + AURA_SIZE,
					auraParams
				)

				local MAX_TOUCHES_PER_TARGET = 3
				
				local count = 0
				for _,enemyPart in ipairs(parts) do
					tap(touchPart, enemyPart)
					count += 1
					if count >= MAX_TOUCHES_PER_TARGET then break end
				end
			end
		end
	end
end)

local BURST_FRAMES = 20

player.CharacterAdded:Connect(function()
	task.spawn(function()
		for i = 1, BURST_FRAMES do
			RunService.PreSimulation:Wait()
			tap(touchPart, enemyPart)
		end
	end)
end)

print("⚡ Multi Target Aura Loaded")
