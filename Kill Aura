-- ⚡ FOCUSED AURA V2 (PRECISION LAYER / NO CONFLICT MODE)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local RANGE = 30
local TOUCH_BURST = 2
local AURA_RATE = 1/20 -- slightly lighter, avoids fighting main aura

--------------------------------------------------
-- STATE
--------------------------------------------------

local lastAura = 0

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function getHRP(char)
	return char and char:FindFirstChild("HumanoidRootPart")
end

--------------------------------------------------
-- SHARED TARGET (IMPORTANT FIX)
-- instead of re-computing, we *prefer external target*
--------------------------------------------------

local function getTarget()
	-- 🔥 PRIORITY: use shared aura target if exists
	if _G.CurrentAuraTarget then
		return _G.CurrentAuraTarget
	end

	-- fallback
	local myChar = LocalPlayer.Character
	local myRoot = getHRP(myChar)
	if not myRoot then return end

	local bestChar
	local bestDist = RANGE

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local r = getHRP(p.Character)
			if r then
				local dist = (r.Position - myRoot.Position).Magnitude
				if dist < bestDist then
					bestDist = dist
					bestChar = p.Character
				end
			end
		end
	end

	return bestChar
end

--------------------------------------------------
-- TOUCH FUNCTION (UNCHANGED BUT CLEANER)
--------------------------------------------------

local function tap(toolPart, enemyPart)
	for _ = 1, TOUCH_BURST do
		firetouchinterest(toolPart, enemyPart, 0)
		firetouchinterest(toolPart, enemyPart, 1)
	end
end

--------------------------------------------------
-- MAIN LOOP (NO HEARTBEAT DESYNC)
--------------------------------------------------

RunService.Heartbeat:Connect(function()

	local now = os.clock()
	if now - lastAura < AURA_RATE then return end
	lastAura = now

	local char = LocalPlayer.Character
	if not char then return end

	local targetChar = getTarget()
	if not targetChar then return end

	-- optional expanded hitbox support (safe)
	local partsToHit

	if _G.GetExpandedParts then
		partsToHit = _G.GetExpandedParts(targetChar)
	end

	if not partsToHit or #partsToHit == 0 then
		local hrp = getHRP(targetChar)
		if not hrp then return end
		partsToHit = {hrp}
	end

	-- 🔥 NO FRAME YIELD INSIDE LOOP (FIXED)
	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then

			local touch = tool:FindFirstChildWhichIsA("TouchTransmitter", true)
			local part = touch and touch.Parent

			if part then
				for _, enemyPart in ipairs(partsToHit) do
					tap(part, enemyPart)
				end
			end
		end
	end

end)

print("⚡ Focused Aura V2 Loaded (Precision Layer)")