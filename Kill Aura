-- ⚡ RTX TOUCH HELPER AURA (SYNCED + LIGHTWEIGHT)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- CONFIG
local RANGE = 30
local TOUCH_BURST = 5

-- cache
local targets = {}

--==================================================
-- TARGET BUILDER (HRP ONLY)
--==================================================
local function updateTargets()
	table.clear(targets)

	local myChar = LocalPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local char = p.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")

			if hrp then
				local dist = (hrp.Position - myRoot.Position).Magnitude
				if dist <= RANGE then
					targets[#targets+1] = hrp
				end
			end
		end
	end
end

--==================================================
-- TOUCH CORE
--==================================================
local function tap(a, b)
	for i = 1, TOUCH_BURST do
		firetouchinterest(a, b, 0)
		firetouchinterest(a, b, 1)
	end
end

--==================================================
-- FRAME-SYNCED LOOP
--==================================================
RunService.PreSimulation:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end

	updateTargets()
	if #targets == 0 then return end

	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then

			local part = tool:FindFirstChildWhichIsA("BasePart")
			if not part then continue end

			for _, enemyHRP in ipairs(targets) do
				tap(part, enemyHRP)
			end

		end
	end
end)

print("⚡ RTX Touch Helper Aura Loaded")
