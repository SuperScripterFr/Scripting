-- ⚡ LOOPBRING V4 (STABLE + RESPAWN SAFE)

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local distance = 3
local AUTO_REJOIN = true
local MEMORY_TIME = 300

local ACTIVE_INTERVAL = 0.02
local IDLE_INTERVAL = 0.08

--------------------------------------------------
-- STATE
--------------------------------------------------

local trackedTargets = {}
local targetMemory = {}

local localCharacter
local localRoot
local localHumanoid

--------------------------------------------------
-- CHARACTER (LOCK SYSTEM FIX)
--------------------------------------------------

local charVersion = 0

local function bindLocalCharacter(char)

	charVersion += 1
	local myVersion = charVersion

	localCharacter = char
	localRoot = nil
	localHumanoid = nil

	if not char then return end

	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	if not root then
		root = char:WaitForChild("HumanoidRootPart", 5)
	end

	if not hum then
		hum = char:WaitForChild("Humanoid", 5)
	end

	-- 🔥 only apply if still current character
	if charVersion ~= myVersion then return end

	localRoot = root
	localHumanoid = hum
end

LocalPlayer.CharacterAdded:Connect(bindLocalCharacter)

if LocalPlayer.Character then
	bindLocalCharacter(LocalPlayer.Character)
end

--------------------------------------------------
-- TARGET SYSTEM
--------------------------------------------------

local function createTarget(player)
	return {
		Player = player,
		Character = nil,
		Root = nil,
		Humanoid = nil,
		Alive = false,
	}
end

local function bindTarget(data, char)

	data.Character = char
	data.Root = nil
	data.Humanoid = nil
	data.Alive = false

	if not char then return end

	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	if not root then root = char:WaitForChild("HumanoidRootPart", 5) end
	if not hum then hum = char:WaitForChild("Humanoid", 5) end

	data.Root = root
	data.Humanoid = hum
	data.Alive = hum and hum.Health > 0

	if hum then
		hum.Died:Connect(function()
			data.Alive = false
			data.Root = nil
		end)
	end
end

local function trackPlayer(player)

	local data = createTarget(player)
	trackedTargets[player.Name] = data

	if player.Character then
		task.spawn(bindTarget, data, player.Character)
	end

	player.CharacterAdded:Connect(function(char)
		bindTarget(data, char)
	end)
end

local function startBring(name)

	local plr = Players:FindFirstChild(name)
	if not plr then return end

	targetMemory[name] = os.clock()

	if not trackedTargets[name] then
		trackPlayer(plr)
	end
end

local function stopBring(name)
	trackedTargets[name] = nil
	targetMemory[name] = nil
end

--------------------------------------------------
-- ENGINE
--------------------------------------------------

local lastUpdate = 0

RunService.PreSimulation:Connect(function()

	if not localRoot then return end

	local activeCount = 0
	for _ in pairs(trackedTargets) do
		activeCount += 1
	end

	local interval = activeCount > 0 and ACTIVE_INTERVAL or IDLE_INTERVAL
	local now = os.clock()

	if now - lastUpdate < interval then return end
	lastUpdate = now

	local targetPos = localRoot.Position + localRoot.CFrame.LookVector * distance

	for _, data in pairs(trackedTargets) do

		if not data.Alive then continue end
		if not data.Root then continue end

		-- 🔥 SAFETY CHECK (prevents respawn tug-of-war)
		if not data.Root.Parent then
			data.Root = nil
			continue
		end

		data.Root.CFrame =
			CFrame.new(targetPos, localRoot.Position)
			* CFrame.Angles(0, math.rad(180), 0)
	end
end)

--------------------------------------------------
-- UI (BLACK → RED GRADIENT)
--------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "LoopbringGUI"
gui.ResetOnSpawn = false
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local function gradient(obj)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(0,0,0)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(180,0,0))
	})
	g.Rotation = 45
	g.Parent = obj
end

local function round(obj,r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,r)
	c.Parent = obj
end

