--// ⚡ LOOPBRING V4 (RESPAWN STABLE + NO TUG-OF-WAR)

--------------------------------------------------
-- SERVICES
--------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

--------------------------------------------------
-- CONFIG
--------------------------------------------------

local distance = 2

local AUTO_REJOIN = true
local MEMORY_TIME = 300

local ACTIVE_INTERVAL = 0.015
local IDLE_INTERVAL = 0.08

--------------------------------------------------
-- STATE
--------------------------------------------------

local trackedTargets = {}
local targetMemory = {}

local localCharacter
local localRoot

-- 🔥 CRITICAL FIX: respawn generation lock
local characterGeneration = 0

--------------------------------------------------
-- LOCAL CHARACTER BIND (FIXED)
--------------------------------------------------

local function bindLocalCharacter(char)

	characterGeneration += 1
	local myGen = characterGeneration

	localCharacter = char
	localRoot = nil

	if not char then return end

	local root = char:WaitForChild("HumanoidRootPart", 5)
	if not root then return end

	-- 🔥 delay stabilization prevents spawn physics fight
	task.delay(0.1, function()
		if characterGeneration == myGen then
			localRoot = root
		end
	end)
end

LocalPlayer.CharacterAdded:Connect(bindLocalCharacter)
if LocalPlayer.Character then
	bindLocalCharacter(LocalPlayer.Character)
end

--------------------------------------------------
-- TARGET DATA
--------------------------------------------------

local function createTargetData(player)
	return {
		Player = player,
		Character = nil,
		Root = nil,
		Humanoid = nil,
		Alive = false,
		gen = 0, -- 🔥 per-target generation
	}
end

--------------------------------------------------
-- SAFE CHARACTER BIND
--------------------------------------------------

local function bindTargetCharacter(data, char)

	data.gen += 1
	local myGen = data.gen

	data.Character = char
	data.Root = nil
	data.Humanoid = nil
	data.Alive = false

	if not char then return end

	local root = char:WaitForChild("HumanoidRootPart", 5)
	local hum = char:WaitForChild("Humanoid", 5)

	-- 🔥 ignore stale respawn frames
	if data.gen ~= myGen then return end
	if not root or not hum then return end

	data.Root = root
	data.Humanoid = hum
	data.Alive = hum.Health > 0

	hum.Died:Connect(function()
		data.Alive = false
		data.Root = nil
	end)
end

--------------------------------------------------
-- TRACKING
--------------------------------------------------

local function trackPlayer(player)

	local data = createTargetData(player)
	trackedTargets[player.Name] = data

	if player.Character then
		task.spawn(bindTargetCharacter, data, player.Character)
	end

	player.CharacterAdded:Connect(function(char)
		bindTargetCharacter(data, char)
	end)
end

local function untrackPlayer(name)
	trackedTargets[name] = nil
end

--------------------------------------------------
-- START / STOP
--------------------------------------------------

local function startBring(name)
	local plr = Players:FindFirstChild(name)
	if not plr then return end

	targetMemory[name] = tick()

	if not trackedTargets[name] then
		trackPlayer(plr)
	end
end

local function stopBring(name)
	trackedTargets[name] = nil
	targetMemory[name] = nil
end

--------------------------------------------------
-- ENGINE LOOP
--------------------------------------------------

local lastUpdate = 0

RunService.PreSimulation:Connect(function()

	local myRoot = localRoot
	if not myRoot then return end

	local activeCount = 0
	for _ in pairs(trackedTargets) do
		activeCount += 1
	end

	local interval = (activeCount > 0) and ACTIVE_INTERVAL or IDLE_INTERVAL

	local now = os.clock()
	if now - lastUpdate < interval then return end
	lastUpdate = now

	--------------------------------------------------
	-- target position
	--------------------------------------------------

	local targetPos =
		myRoot.Position +
		myRoot.CFrame.LookVector * distance

	--------------------------------------------------
	-- MOVE (SAFE GUARDED)
	--------------------------------------------------

	for _, data in pairs(trackedTargets) do

		if not data.Alive then continue end

		local root = data.Root
		local hum = data.Humanoid

		-- 🔥 full validity gate (IMPORTANT FIX)
		if not root or not hum then continue end
		if hum.Health <= 0 then continue end
		if not root.Parent then continue end

		-- 🔥 prevents respawn “ghost body tug”
		if (root.Position - myRoot.Position).Magnitude > 500 then
			continue
		end

		root.CFrame =
			CFrame.new(targetPos, myRoot.Position)
			* CFrame.Angles(0, math.rad(180), 0)
	end
end)

