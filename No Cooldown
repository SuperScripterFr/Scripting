-- ⚡ No Cooldown

local RunService = game:GetService("RunService")

--================================================
-- ⚡ GLOBAL COOLDOWN BREAKER (Original Power)
--================================================

hookfunction(delay, function(_,func)
	task.spawn(func)
end)

hookfunction(spawn, function(func)
	task.spawn(func)
end)

hookfunction(wait, function()
	return RunService.PreSimulation:Wait()
end)

hookfunction(task.wait, function()
	return RunService.PreSimulation:Wait()
end)

print("⚡ No Cooldown Running")
