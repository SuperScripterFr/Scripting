-- ⚡ NO COOLDOWN (STABLE TIMING VERSION)

local RunService = game:GetService("RunService")

--------------------------------------------------
-- SAFE FAST YIELD (NO ENGINE DISRUPTION)
--------------------------------------------------

local function fastYield()
	-- only 1 frame sync, not double sync (prevents lag stacking)
	RunService.Heartbeat:Wait()
end

--------------------------------------------------
-- SAFE HOOKING (LESS INTERFERENCE)
--------------------------------------------------

local oldWait = wait
local oldTaskWait = task.wait

hookfunction(oldWait, function(t)
	if t and t > 0 then
		fastYield()
	else
		return oldWait(t)
	end
end)

hookfunction(oldTaskWait, function(t)
	if t and t > 0 then
		fastYield()
	else
		return oldTaskWait(t)
	end
end)

print("⚡ No Cooldown (Stable Version) Loaded")