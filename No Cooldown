-- ⚡ No Cooldown V6(7) (Cooldown Breaker + Combat Loop)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

--================================================
-- ⚡ GLOBAL COOLDOWN BREAKER (Original Power)
--================================================

hookfunction(wait, function()
	return RunService.PostSimulation:Wait()
end)

hookfunction(task.wait, function()
	return RunService.PostSimulation:Wait()
end)

hookfunction(delay, function(_,func)
	task.spawn(func)
end)

hookfunction(spawn, function(func)
	task.spawn(func)
end)

--================================================
-- CHARACTER + TOOL TRACKING
--================================================

local Character
local FightEvent

local function setupTool(tool)

	local remote = tool:FindFirstChild("FightEvent")

	if remote then
		FightEvent = remote
	end

end

local function hookCharacter(char)

	Character = char
	FightEvent = nil

	for _,v in ipairs(char:GetChildren()) do
		if v:IsA("Tool") then
			setupTool(v)
		end
	end

	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			setupTool(child)
		end
	end)

end

if LocalPlayer.Character then
	hookCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(hookCharacter)

--================================================
-- ⚡ PING SAFE POWER CORE (NO REMOTE FLOOD)
--================================================

local INTERNAL_RATE = 1/go      -- base rhythm (increase for more power)
local BURST = 2                  -- activation bursts
local TOOL_SCAN = 0.4

local toolCache = {}
local lastScan = 0
local acc = 0

local function scanTools()

	table.clear(toolCache)

	local char = Character
	if not char then return end

	for _,v in ipairs(char:GetChildren()) do
		if v:IsA("Tool") then
			table.insert(toolCache, v)
		end
	end

end

RunService.Heartbeat:Connect(function(dt)

	if not Character then return end

	acc += dt

	if tick() - lastScan > TOOL_SCAN then
		lastScan = tick()
		scanTools()
	end

	while acc >= INTERNAL_RATE do
		acc -= INTERNAL_RATE

		for b = 1, BURST do
			for i = 1, #toolCache do
				local tool = toolCache[i]
				pcall(tool.Activate, tool)
			end
		end

	end

end)

print("⚡ No Cooldown V6(7) Running")
