-- ⚡ QUANTUM INSTANT RESPAWN ENGINE + UI

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local GuideEvent = ReplicatedStorage:FindFirstChild("Guide")

local TOGGLE_KEY = Enum.KeyCode.R

local active = false
local lastRespawn = 0

local RESPAWN_COOLDOWN = 0.
local FAILSAFE_REFIRE = 0.1

local diedLock = false
local diedConn
local stateConn
local charConn

--==================================================
-- ⚡ TRUE INSTANT RESPAWN
--==================================================

local fired = false

local function fireRespawn()

	if fired then return end
	fired = true

	if GuideEvent then
		pcall(function()
			GuideEvent:FireServer()
		end)
	else
		pcall(function()
			player:LoadCharacter()
		end)
	end

	-- reset lock quickly (no multi-trigger spam)
	task.delay(0.1, function()
		fired = false
	end)
end

--==================================================
-- ⚡ CHARACTER HOOK
--==================================================

local function hookCharacter(char)

	diedLock = false

	if diedConn then diedConn:Disconnect() end
	if stateConn then stateConn:Disconnect() end

	local hum = char:WaitForChild("Humanoid",1)
	if not hum then return end

	stateConn = hum.StateChanged:Connect(function(_,new)
		if active and new == Enum.HumanoidStateType.Dead then
			fireRespawn()
		end
	end)

	diedConn = hum.Died:Connect(function()
		if active then
			fireRespawn()
		end
	end)

end

--==================================================
-- ⚡ UI (MATCHES OVERDRIVE BUTTON)
--==================================================

local gui = Instance.new("ScreenGui", game.CoreGui)
gui.ResetOnSpawn = false

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.fromOffset(120,42)
btn.Position = UDim2.new(1,-140,1,-130) -- ABOVE Overdrive button
btn.BackgroundColor3 = Color3.fromRGB(20,20,35)
btn.TextColor3 = Color3.fromRGB(255,60,60)
btn.Text = "RESPAWN"
btn.Font = Enum.Font.GothamBold
btn.TextScaled = true
btn.Active = true
btn.Draggable = true

Instance.new("UICorner",btn).CornerRadius = UDim.new(0,10)

local stroke = Instance.new("UIStroke",btn)
stroke.Color = Color3.fromRGB(255,60,60)

--==================================================
-- ⚡ TOGGLE SYSTEM
--==================================================

local function setState(state)

	active = state

	btn.Text = active and "RESPAWN: ON" or "RESPAWN: OFF"

	if charConn then charConn:Disconnect() end
	if diedConn then diedConn:Disconnect() end
	if stateConn then stateConn:Disconnect() end

	if active then
		print("⚡ Quantum Respawn ON")

		charConn = player.CharacterAdded:Connect(hookCharacter)

		if player.Character then
			hookCharacter(player.Character)
		end
	else
		print("⚡ Quantum Respawn OFF")
	end

end

btn.MouseButton1Click:Connect(function()
	setState(not active)
end)

-- KEYBIND (still works)
UIS.InputBegan:Connect(function(i,gp)
	if not gp and i.KeyCode == TOGGLE_KEY then
		setState(not active)
	end
end)

print("⚡ Quantum Respawn Ready (UI Loaded)")
