-- ⚡ QUANTUM FAST RESPAWN V3
-- Minimal Overhead Version

----------------------------------------------------
-- SERVICES
----------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local GuideEvent = ReplicatedStorage:FindFirstChild("Guide")

----------------------------------------------------
-- SETTINGS
----------------------------------------------------

local TOGGLE_KEY = Enum.KeyCode.R
local HEALTH_THRESHOLD = 6

----------------------------------------------------
-- STATE
----------------------------------------------------

local active = false

local firing = false
local lastFire = 0

local CharacterConnections = {}

----------------------------------------------------
-- CONNECTION CLEANUP
----------------------------------------------------

local function disconnectCharacterConnections()

	for i = 1,#CharacterConnections do

		local conn = CharacterConnections[i]

		if conn and conn.Connected then
			conn:Disconnect()
		end
	end

	table.clear(CharacterConnections)
end

local function track(conn)
	table.insert(CharacterConnections, conn)
	return conn
end

----------------------------------------------------
-- FAST FIRE
----------------------------------------------------

local function fireRespawn()

	local now = os.clock()

	if firing then
		return
	end

	-- prevents spam during instant spawnkills
	if now - lastFire < 0.1 then
		return
	end

	lastFire = now
	firing = true

	disconnectCharacterConnections()

	if GuideEvent then
		GuideEvent:FireServer()
	else
		player:LoadCharacter()
	end

	task.delay(0.1,function()
		firing = false
	end)
end

----------------------------------------------------
-- CHARACTER HOOK
----------------------------------------------------

local function hookCharacter(char)

	disconnectCharacterConnections()

	local hum = char:FindFirstChildOfClass("Humanoid")

	if not hum then
		return
	end

	local triggered = false

	local function trigger()

		if triggered then
			return
		end

		if not active then
			return
		end

		triggered = true

		fireRespawn()
	end

	------------------------------------------------
	-- PRE-DEATH
	------------------------------------------------

	track(hum.HealthChanged:Connect(function(hp)

		if hp <= HEALTH_THRESHOLD then
			trigger()
		end
	end))

	------------------------------------------------
	-- FALLBACK
	------------------------------------------------

	track(hum.Died:Connect(trigger))
end

----------------------------------------------------
-- CHARACTER LISTENER
----------------------------------------------------

player.CharacterAdded:Connect(function(char)

	if active then
		hookCharacter(char)
	end
end)

----------------------------------------------------
-- TOGGLE
----------------------------------------------------

local function setState(state)

	active = state

	if active then

		print("⚡ Respawn ON")

		if player.Character then
			hookCharacter(player.Character)
		end

	else

		print("⚡ Respawn OFF")

		disconnectCharacterConnections()
	end
end

----------------------------------------------------
-- KEYBIND
----------------------------------------------------

UserInputService.InputBegan:Connect(function(input,gp)

	if gp then
		return
	end

	if input.KeyCode == TOGGLE_KEY then
		setState(not active)
	end
end)

----------------------------------------------------
-- UI
----------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "QuantumRespawnUI"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local button = Instance.new("TextButton")
button.Parent = gui

button.Size = UDim2.fromOffset(170,55)
button.Position = UDim2.fromScale(0.98,0.55)
button.AnchorPoint = Vector2.new(1,0.5)

button.BackgroundColor3 = Color3.fromRGB(15,15,20)
button.TextColor3 = Color3.fromRGB(255,255,255)

button.Font = Enum.Font.GothamBold
button.TextSize = 15

button.Active = true
button.Draggable = true

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,12)
corner.Parent = button

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Parent = button

local function updateButton()

	if active then
		button.Text = "⚡ RESPAWN: ON"
		stroke.Color = Color3.fromRGB(0,255,100)
	else
		button.Text = "⚡ RESPAWN: OFF"
		stroke.Color = Color3.fromRGB(255,60,60)
	end
end

button.MouseButton1Click:Connect(function()

	setState(not active)

	updateButton()
end)

updateButton()

print("⚡ Quantum Fast Respawn V3 Loaded")