-- ⚡ QUANTUM FRAME-PERFECT RESPAWN V2
-- PERFECTED STABLE CORE

----------------------------------------------------
-- SERVICES
----------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local GuideEvent = ReplicatedStorage:FindFirstChild("Guide")

----------------------------------------------------
-- STATE
----------------------------------------------------

local active = false
local firing = false

local TOGGLE_KEY = Enum.KeyCode.R

----------------------------------------------------
-- CONNECTION REGISTRIES
----------------------------------------------------

-- ⚡ character-only connections
local CharacterConnections = {}

-- ⚡ persistent connections
local PersistentConnections = {}

----------------------------------------------------
-- ⚡ TRACKERS
----------------------------------------------------

local function trackCharacter(conn)
	table.insert(CharacterConnections, conn)
	return conn
end

local function trackPersistent(conn)
	table.insert(PersistentConnections, conn)
	return conn
end

----------------------------------------------------
-- ⚡ CLEAN CHARACTER CONNECTIONS ONLY
----------------------------------------------------

local function disconnectCharacterConnections()

	for _, conn in ipairs(CharacterConnections) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end

	table.clear(CharacterConnections)
end

----------------------------------------------------
-- ⚡ FRAME PERFECT FIRE
----------------------------------------------------

local function fireRespawn()

	if firing then
		return
	end

	firing = true

	local success = false

	local function attempt()

		if success then
			return
		end

		local ok = pcall(function()

			if GuideEvent then
				GuideEvent:FireServer()
			else
				player:LoadCharacter()
			end
		end)

		if ok then
			success = true
		end
	end

	------------------------------------------------
	-- ⚡ INSTANT SHOT
	------------------------------------------------

	attempt()

	------------------------------------------------
	-- ⚡ FRAME-SYNCED BURSTS
	------------------------------------------------

	RunService.PreSimulation:Wait()
	attempt()

	RunService.PostSimulation:Wait()
	attempt()

	for _ = 1, 2 do
		RunService.PreSimulation:Wait()
		attempt()
	end

	------------------------------------------------
	-- ⚡ RESET
	------------------------------------------------

	task.delay(0.12, function()
		firing = false
	end)
end

----------------------------------------------------
-- ⚡ CHARACTER HOOK
----------------------------------------------------

local function hookCharacter(char)

	------------------------------------------------
	-- ⚡ WIPE OLD CHARACTER HOOKS ONLY
	------------------------------------------------

	disconnectCharacterConnections()

	local hum = char:WaitForChild("Humanoid", 1)

	if not hum then
		return
	end

	local triggered = false

	------------------------------------------------
	-- ⚡ PRE-DEATH WINDOW
	------------------------------------------------

	trackCharacter(hum.HealthChanged:Connect(function(hp)

		if not active then
			return
		end

		if triggered then
			return
		end

		if hp <= 6 then
			triggered = true
			fireRespawn()
		end
	end))

	------------------------------------------------
	-- ⚡ FALLBACK
	------------------------------------------------

	trackCharacter(hum.Died:Connect(function()

		if not active then
			return
		end

		if triggered then
			return
		end

		triggered = true

		fireRespawn()
	end))
end

----------------------------------------------------
-- ⚡ SINGLE PERSISTENT CHARACTER LISTENER
----------------------------------------------------

trackPersistent(player.CharacterAdded:Connect(function(char)

	if active then
		hookCharacter(char)
	end
end))

----------------------------------------------------
-- ⚡ TOGGLE
----------------------------------------------------

local function setState(state)

	active = state

	if active then

		print("⚡ Respawn ON")

		if player.Character then
			hookCharacter(player.Character)
		end

	else

		print("⚡ Respawn OFF")

		disconnectCharacterConnections()
	end
end

----------------------------------------------------
-- INPUT
----------------------------------------------------

UIS.InputBegan:Connect(function(i, g)

	if g then
		return
	end

	if i.KeyCode == TOGGLE_KEY then
		setState(not active)
	end
end)

----------------------------------------------------
-- UI TOGGLE BUTTON
----------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "QuantumRespawnUI"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local toggleButton = Instance.new("TextButton")
toggleButton.Parent = gui

toggleButton.Size = UDim2.fromOffset(170, 55)
toggleButton.Position = UDim2.fromScale(0.98, 0.55)
toggleButton.AnchorPoint = Vector2.new(1, 0.5)

toggleButton.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)

toggleButton.Font = Enum.Font.GothamBold
toggleButton.TextSize = 15

toggleButton.Text = "⚡ RESPAWN: OFF"

toggleButton.Active = true
toggleButton.Draggable = true

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = toggleButton

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Parent = toggleButton

----------------------------------------------------
-- BUTTON UPDATE
----------------------------------------------------

local function updateButton()

	if active then
		toggleButton.Text = "⚡ RESPAWN: ON"
		stroke.Color = Color3.fromRGB(0, 255, 100)
	else
		toggleButton.Text = "⚡ RESPAWN: OFF"
		stroke.Color = Color3.fromRGB(255, 60, 60)
	end
end

----------------------------------------------------
-- HOOK INTO STATE CHANGES
----------------------------------------------------

local oldSetState = setState

setState = function(state)

	oldSetState(state)

	updateButton()
end

----------------------------------------------------
-- CLICK TO TOGGLE
----------------------------------------------------

toggleButton.MouseButton1Click:Connect(function()

	setState(not active)

end)

updateButton()

----------------------------------------------------
-- INIT
----------------------------------------------------

print("⚡ Quantum Frame-Perfect Respawn V2 Loaded")
