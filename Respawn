-- ⚡ QUANTUM FRAME-PERFECT RESPAWN V2 (STABLE CORE + NO LEAKS)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local GuideEvent = ReplicatedStorage:FindFirstChild("Guide")

----------------------------------------------------
-- STATE
----------------------------------------------------

local active = false
local firing = false

local TOGGLE_KEY = Enum.KeyCode.R

-- ⚡ CONNECTION REGISTRY (THE FIX)
local Connections = {}
local currentHumanoid

----------------------------------------------------
-- ⚡ SAFE CONNECT
----------------------------------------------------

local function track(conn)
	table.insert(Connections, conn)
	return conn
end

----------------------------------------------------
-- ⚡ DISCONNECT ALL (CORE FIX)
----------------------------------------------------

local function disconnectAll()
	for i, conn in ipairs(Connections) do
		if conn and conn.Connected then
			conn:Disconnect()
		end
	end
	table.clear(Connections)
	currentHumanoid = nil
end

----------------------------------------------------
-- ⚡ FIRE RESPAWN CORE (UNCHANGED FEEL)
----------------------------------------------------

local function fireRespawn()

	if firing then return end
	firing = true

	local success = false

	local function attempt()
		if success then return end

		local ok = pcall(function()
			if GuideEvent then
				GuideEvent:FireServer()
			else
				player:LoadCharacter()
			end
		end)

		if ok then
			success = true
		end
	end

	attempt()

	RunService.PreSimulation:Wait()
	attempt()

	RunService.PostSimulation:Wait()
	attempt()

	for _ = 1, 2 do
		RunService.PreSimulation:Wait()
		attempt()
	end

	task.delay(0.12, function()
		firing = false
	end)
end

----------------------------------------------------
-- ⚡ CHARACTER HOOK (NO STACK VERSION)
----------------------------------------------------

local function hookCharacter(char)

	-- ⚡ IMPORTANT: wipe old hooks first
	disconnectAll()

	local hum = char:WaitForChild("Humanoid", 1)
	if not hum then return end

	currentHumanoid = hum

	local triggered = false

	track(hum.HealthChanged:Connect(function(hp)
		if not active or triggered then return end
		if hp <= 6 then
			triggered = true
			fireRespawn()
		end
	end))

	track(hum.Died:Connect(function()
		if not active or triggered then return end
		triggered = true
		fireRespawn()
	end))
end

----------------------------------------------------
-- ⚡ SINGLE CHARACTER LISTENER (NO STACKING)
----------------------------------------------------

track(player.CharacterAdded:Connect(function(char)
	if active then
		hookCharacter(char)
	end
end))

----------------------------------------------------
-- ⚡ TOGGLE
----------------------------------------------------

local function setState(state)

	active = state

	if active then
		print("⚡ Respawn ON")

		if player.Character then
			hookCharacter(player.Character)
		end

	else
		print("⚡ Respawn OFF")
		disconnectAll()
	end
end

----------------------------------------------------
-- INPUT
----------------------------------------------------

UIS.InputBegan:Connect(function(i, g)
	if g then return end
	if i.KeyCode == TOGGLE_KEY then
		setState(not active)
	end
end)

----------------------------------------------------
-- INIT
----------------------------------------------------

print("⚡ Frame Perfect Respawn V2 (Leak-Free Core) Loaded")
