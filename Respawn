-- ⚡ QUANTUM RESPAWN CORE (CLEAN FINAL)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local GuideEvent = workspace:FindFirstChild("Guide", true)

local active = false
local firing = false

local characterConn

---------------------------------------------------
-- ⚡ FIRE ENGINE (FRAME-SYNCED BUT SAFE)
---------------------------------------------------
local function fireRespawn()

	if firing then return end
	firing = true

	local function attempt()
		pcall(function()
			if GuideEvent then
				GuideEvent:FireServer()
			else
				player:LoadCharacter()
			end
		end)
	end

	attempt()

	RunService.PreSimulation:Wait()
	attempt()

	RunService.PostSimulation:Wait()
	attempt()

	for _ = 1, 2 do
		RunService.PreSimulation:Wait()
		attempt()
	end

	task.delay(0.15, function()
		firing = false
	end)
end

---------------------------------------------------
-- ⚡ CHARACTER PIPELINE (NO STACKING)
---------------------------------------------------
local function hookCharacter(char)

	local hum = char:WaitForChild("Humanoid", 2)
	if not hum then return end

	local triggered = false

	hum.HealthChanged:Connect(function(hp)
		if not active or triggered then return end
		if hp <= 6 then
			triggered = true
			fireRespawn()
		end
	end)

	hum.Died:Connect(function()
		if not active or triggered then return end
		triggered = true
		fireRespawn()
	end)
end

---------------------------------------------------
-- ⚡ SINGLE CONNECTION MANAGER
---------------------------------------------------
local function bindCharacterListener()

	if characterConn then
		characterConn:Disconnect()
	end

	characterConn = player.CharacterAdded:Connect(function(char)
		if active then
			hookCharacter(char)
		end
	end)

	if player.Character and active then
		hookCharacter(player.Character)
	end
end

---------------------------------------------------
-- ⚡ STATE CONTROL
---------------------------------------------------
local function setState(state)

	active = state

	if active then
		bindCharacterListener()
	else
		if characterConn then
			characterConn:Disconnect()
			characterConn = nil
		end
	end
end

local gui = Instance.new("ScreenGui")
gui.Name = "RespawnUI"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local btn = Instance.new("TextButton")
btn.Size = UDim2.fromOffset(160, 60)
btn.Position = UDim2.new(1, -180, 0.5, 0)
btn.TextColor3 = Color3.fromRGB(255,0,0)
btn.BackgroundColor3 = Color3.fromRGB(0,0,0)
btn.Text = "RESPAWN: OFF"
btn.Font = Enum.Font.Code
btn.Parent = gui

btn.MouseButton1Click:Connect(function()
	setState(not active)
	btn.Text = active and "RESPAWN: ON" or "RESPAWN: OFF"
end)

---------------------------------------------------
-- ⚡ INPUT (KEYBOARD)
---------------------------------------------------
UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end

	if input.KeyCode == Enum.KeyCode.R then
		setState(not active)
	end
end)
