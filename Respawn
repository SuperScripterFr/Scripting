-- ⚡ QUANTUM RESPAWN V7 (IMMORTAL CONTROLLER CORE)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local GuideEvent = ReplicatedStorage:FindFirstChild("Guide")

-- CONFIG
local TOGGLE_KEY = Enum.KeyCode.R
local LOW_HP_THRESHOLD = 6

-- STATE
local active = false
local firing = false

local currentChar
local humConn
local diedConn

local charToken = 0 -- prevents old-character leakage

----------------------------------------------------
-- CLEAN CHARACTER HOOKS
----------------------------------------------------

local function clearHooks()
	if humConn then humConn:Disconnect() humConn = nil end
	if diedConn then diedConn:Disconnect() diedConn = nil end
end

----------------------------------------------------
-- ⚡ RESPAWN ENGINE (NO WAIT CHAINS)
----------------------------------------------------

local function fireRespawn(myToken)
	if firing then return end
	if myToken ~= charToken then return end

	firing = true

	-- single burst only (no yield chains)
	pcall(function()
		if GuideEvent then
			GuideEvent:FireServer()
		else
			player:LoadCharacter()
		end
	end)

	-- micro safety pulse (non-blocking)
	task.delay(0.04, function()
		if myToken ~= charToken then return end
		pcall(function()
			if GuideEvent then
				GuideEvent:FireServer()
			end
		end)
	end)

	task.delay(0.1, function()
		firing = false
	end)
end

----------------------------------------------------
-- ⚡ CHARACTER BIND (CLEAN LIFECYCLE)
----------------------------------------------------

local function hookCharacter(char)
	charToken += 1
	local myToken = charToken

	currentChar = char
	clearHooks()

	local hum = char:WaitForChild("Humanoid", 2)
	if not hum then return end

	local triggered = false

	humConn = hum.HealthChanged:Connect(function(hp)
		if not active then return end
		if myToken ~= charToken then return end
		if triggered then return end

		if hp <= LOW_HP_THRESHOLD then
			triggered = true
			fireRespawn(myToken)
		end
	end)

	diedConn = hum.Died:Connect(function()
		if not active then return end
		if myToken ~= charToken then return end
		if triggered then return end

		triggered = true
		fireRespawn(myToken)
	end)
end

----------------------------------------------------
-- ⚡ SINGLE GLOBAL LISTENER (NO STACKS EVER)
----------------------------------------------------

player.CharacterAdded:Connect(function(char)
	if active then
		hookCharacter(char)
	end
end)

----------------------------------------------------
-- TOGGLE
----------------------------------------------------

local function setState(state)
	active = state

	if active then
		print("⚡ Respawn ON")
		if player.Character then
			hookCharacter(player.Character)
		end
	else
		print("⚡ Respawn OFF")
		clearHooks()
		charToken += 1 -- invalidate everything
	end
end

UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == TOGGLE_KEY then
		setState(not active)
	end
end)

print("⚡ Quantum Respawn V7 Loaded (Immortal Core)")
