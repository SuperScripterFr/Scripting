-- ⚡ QUANTUM FRAME-PERFECT RESPAWN V2

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local GuideEvent = ReplicatedStorage:FindFirstChild("Guide")

local active = false
local firing = false

local TOGGLE_KEY = Enum.KeyCode.R

--========================================
-- ⚡ FRAME PERFECT FIRE
--========================================
local function fireRespawn()

	if firing then return end
	firing = true

	local attempts = 0
	local success = false

	local function attempt()
		if success then return end

		local ok = pcall(function()
			if GuideEvent then
				GuideEvent:FireServer()
			else
				player:LoadCharacter()
			end
		end)

		if ok then
			success = true
		end
	end

	-- ⚡ FIRST SHOT (INSTANT)
	attempt()

	-- ⚡ FRAME-SYNCED FOLLOW UPS (NOT TIME BASED)
	RunService.PreSimulation:Wait()
	attempt()

	RunService.PostSimulation:Wait()
	attempt()

	-- ⚡ FINAL SAFETY BURST
	for i = 1,2 do
		RunService.PreSimulation:Wait()
		attempt()
	end

	-- reset
	task.delay(0.15,function()
		firing = false
	end)
end

--========================================
-- ⚡ CHARACTER HOOK
--========================================
local function hookCharacter(char)

	local hum = char:WaitForChild("Humanoid",1)
	if not hum then return end

	local triggered = false

	-- ⚡ PRE-DEATH WINDOW (CRITICAL)
	hum.HealthChanged:Connect(function(hp)
		if active and not triggered and hp <= 6 then
			triggered = true
			fireRespawn()
		end
	end)

	-- ⚡ FALLBACK
	hum.Died:Connect(function()
		if active and not triggered then
			triggered = true
			fireRespawn()
		end
	end)
end

--========================================
-- ⚡ TOGGLE
--========================================
local function setState(state)
	active = state

	if active then
		print("⚡ Respawn ON")

		player.CharacterAdded:Connect(hookCharacter)

		if player.Character then
			hookCharacter(player.Character)
		end
	else
		print("⚡ Respawn OFF")
	end
end

UIS.InputBegan:Connect(function(i,g)
	if not g and i.KeyCode == TOGGLE_KEY then
		setState(not active)
	end
end)

print("⚡ Frame Perfect Respawn Loaded")
