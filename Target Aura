-- ============ PLAYER BUTTONS ============
local function createPlayerButton(plr)
	local btn = Instance.new("TextButton", PlayerFrame)
	btn.Size = UDim2.new(1, -12, 0, 26)
	btn.Text = plr.Name
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 13
	btn.AutoButtonColor = false
	btn.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
	btn.TextColor3 = Color3.fromRGB(215, 225, 255)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
	local stroke = Instance.new("UIStroke", btn)
	stroke.Thickness = 1
	stroke.Color = Color3.fromRGB(90, 120, 255)
	stroke.Transparency = 0.45

	local function paint()
		local on = table.find(getgenv().configs.TargetList, plr) ~= nil
		btn.BackgroundColor3 = on and Color3.fromRGB(20, 25, 45) or Color3.fromRGB(12, 12, 16)
		stroke.Color = on and Color3.fromRGB(90, 150, 255) or Color3.fromRGB(90, 120, 255)
	end

	btn.MouseButton1Click:Connect(function()
		local list = getgenv().configs.TargetList
		local idx = table.find(list, plr)
		if idx then
			table.remove(list, idx)
		else
			table.insert(list, plr)
		end
		paint()
	end)
	paint()
	return btn
end

local function UpdatePlayers()
	for _, c in ipairs(PlayerFrame:GetChildren()) do
		if c:IsA("TextButton") and c.Name ~= "QuickBtn" then
			c:Destroy()
		end
	end
	local order = 10
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp then
			local b = createPlayerButton(p)
			b.LayoutOrder = order
			order += 1
		end
	end
end

addQuick("ALL", 1, function()
	local list = getgenv().configs.TargetList
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and not table.find(list, p) then table.insert(list, p) end
	end
	UpdatePlayers()
end)
addQuick("NONE", 2, function()
	table.clear(getgenv().configs.TargetList)
	UpdatePlayers()
end)

AuraBtn.MouseButton1Click:Connect(function()
	PlayerFrame.Visible = not PlayerFrame.Visible
	if PlayerFrame.Visible then UpdatePlayers() end
end)

Players.PlayerAdded:Connect(UpdatePlayers)
Players.PlayerRemoving:Connect(UpdatePlayers)
UpdatePlayers()
-- ============ ATTACK ENGINE ============
local lastFire = 0
local FIRE_RATE = 1 / 60
local TOUCH_BURST = 2

local PRIORITY = { "HumanoidRootPart", "Head" }

local function getTargets()
	local t = {}
	local list = getgenv().configs.TargetList
	for _, plr in ipairs(list) do
		local char = plr.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hum and hrp and hum.Health > 0 then
				t[#t + 1] = char
			end
		end
	end
	return t
end

local function hitTarget(touch, char)
	for i = 1, #PRIORITY do
		local part = char:FindFirstChild(PRIORITY[i])
		if part and part:IsA("BasePart") then
			for _ = 1, TOUCH_BURST do
				firetouchinterest(touch, part, 0)
				firetouchinterest(touch, part, 1)
			end
		end
	end
end

RunService.Stepped:Connect(function()
	if not Run then return end
	local list = getgenv().configs.TargetList
	if #list == 0 then return end

	local now = os.clock()
	if now - lastFire < FIRE_RATE then return end
	lastFire = now

	local char = lp.Character
	if not char then return end

	local targets = getTargets()
	if #targets == 0 then return end

	for i = 1, #toolCache do
		local touch = toolCache[i]
		if touch and touch.Parent then
			-- expanded hitbox: touch every target part inside the aura box
			local parts = workspace:GetPartBoundsInBox(touch.CFrame, touch.Size + getgenv().configs.Size, overlapParams)
			for k = 1, #parts do
				local model = parts[k]:FindFirstAncestorWhichIsA("Model")
				if model and table.find(targets, model) then
					for _ = 1, TOUCH_BURST do
						firetouchinterest(touch, parts[k], 0)
						firetouchinterest(touch, parts[k], 1)
					end
				end
			end
			-- guaranteed direct HRP + Head hits
			for j = 1, #targets do
				hitTarget(touch, targets[j])
			end
		end
	end
end)

