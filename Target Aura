-- ============ OVERLAP (now actually works) ============
local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Blacklist

-- ============ TOOL CACHE ============
local toolCache = {}

local function rebuildTools()
	table.clear(toolCache)
	local char = lp.Character
	if not char then return end
	overlapParams.FilterDescendantsInstances = { char }
	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			local tx = t:FindFirstChildWhichIsA("TouchTransmitter", true)
			local part = tx and tx.Parent
			if part and part:IsA("BasePart") then toolCache[#toolCache + 1] = part end
		end
	end
end

local function onToolChange(c)
	if c:IsA("Tool") then task.defer(rebuildTools) end
end

lp.CharacterAdded:Connect(function(char)
	rebuildTools()
	char.ChildAdded:Connect(onToolChange)
	char.ChildRemoved:Connect(onToolChange)
end)
if lp.Character then
	rebuildTools()
	lp.Character.ChildAdded:Connect(onToolChange)
	lp.Character.ChildRemoved:Connect(onToolChange)
end
