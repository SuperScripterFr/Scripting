-- ⚡ ULTRA-INSTANT TOOL GRABBER
-- Admin-only client utility

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Tycoons = workspace:WaitForChild("Tycoons")

--// CONFIG
local RESPAWN_BLAST_TIME = 2
local RESPAWN_BURSTS = 2
local RESPAWN_TOUCHES = 2

local BACKGROUND_BURSTS = 2
local BACKGROUND_TOUCHES = 2

local PAD_TOUCH_RANGE = math.huge
local HEARTBEAT_INTERVAL = 0

local allowedBases = {
	Stone = true,
	Magic = true,
	Storm = true,
	Robotic = true,
}

local excludedBases = {
	Insanity = true,
	Giant = true,
	Dark = true,
	Spike = true,
	Web = true,
	Strong = true,
}

local requiredTools = {
	["Energy Sword"] = true,
	["Fist"] = true,
	["Staff"] = true,
	["Axe"] = true,
}

--// STATE
local pads = {}
local padList = {}

local ownedTools = {}

local root = nil
local respawnRunning = false
local lastHeartbeat = 0

--// TOOL CACHE
local function scanContainer(container)
	if not container then
		return
	end

	for _, object in ipairs(container:GetChildren()) do
		if object:IsA("Tool") and requiredTools[object.Name] then
			ownedTools[object.Name] = true
		end
	end
end

local function rebuildToolCache()
	table.clear(ownedTools)

	scanContainer(LocalPlayer.Backpack)
	scanContainer(LocalPlayer.Character)
end

local function hasRequiredTools()
	for name in pairs(requiredTools) do
		if not ownedTools[name] then
			return false
		end
	end

	return true
end

local function watchContainer(container)
	if not container then
		return
	end

	container.ChildAdded:Connect(function(object)
		if object:IsA("Tool") and requiredTools[object.Name] then
			ownedTools[object.Name] = true
		end
	end)

	container.ChildRemoved:Connect(function(object)
		if object:IsA("Tool") and requiredTools[object.Name] then
			ownedTools[object.Name] = nil
		end
	end)
end

watchContainer(LocalPlayer.Backpack)

LocalPlayer.Backpack.ChildAdded:Connect(function(object)
	if object:IsA("Tool") and requiredTools[object.Name] then
		ownedTools[object.Name] = true
	end
end)

LocalPlayer.CharacterAdded:Connect(function(character)
	table.clear(ownedTools)

	character.ChildAdded:Connect(function(object)
		if object:IsA("Tool") and requiredTools[object.Name] then
			ownedTools[object.Name] = true
		end
	end)

	character.ChildRemoved:Connect(function(object)
		if object:IsA("Tool") and requiredTools[object.Name] then
			ownedTools[object.Name] = nil
		end
	end)

	task.defer(function()
		scanContainer(character)
		scanContainer(LocalPlayer.Backpack)
	end)
end)

rebuildToolCache()

--// ROOT CACHE
local function updateRoot()
	local character = LocalPlayer.Character

	if not character then
		root = nil
		return nil
	end

	root = character:FindFirstChild("HumanoidRootPart")

	return root
end

--// TOUCH
local function touchPair(rootPart, padPart)
	if not rootPart or not padPart then
		return
	end

	pcall(firetouchinterest, rootPart, padPart, 0)
	pcall(firetouchinterest, rootPart, padPart, 1)
end

local function firePad(padPart, bursts, touches)
	if not root or not padPart or not padPart.Parent then
		return
	end

	for _ = 1, bursts do
		for _ = 1, touches do
			touchPair(root, padPart)
		end
	end
end

--// PAD REGISTRATION
local function registerPad(pad)
	if not pad or not pad:IsA("BasePart") then
		return
	end

	if pads[pad] then
		return
	end

	local parent = pad.Parent
	local baseModel = parent and parent.Parent

	if not baseModel then
		return
	end

	local baseName = baseModel.Name

	if excludedBases[baseName] then
		return
	end

	if next(allowedBases) and not allowedBases[baseName] then
		return
	end

	pads[pad] = true
	padList[#padList + 1] = pad
end

--// INITIAL PAD SCAN
for _, descendant in ipairs(Tycoons:GetDescendants()) do
	if descendant:IsA("TouchTransmitter") then
		local pad = descendant.Parent

		if pad and pad.Parent and pad.Parent.Parent then
			if pad.Parent.Parent.Name:find("GearGiver1", 1, true) then
				registerPad(pad)
			end
		end
	end
end

--// NEW PADS
Tycoons.DescendantAdded:Connect(function(descendant)
	if not descendant:IsA("TouchTransmitter") then
		return
	end

	local pad = descendant.Parent

	if not pad or not pad.Parent or not pad.Parent.Parent then
		return
	end

	if pad.Parent.Parent.Name:find("GearGiver1", 1, true) then
		registerPad(pad)
	end
end)

--// REMOVE DESTROYED PADS FROM CACHE
Tycoons.DescendantRemoving:Connect(function(descendant)
	if not pads[descendant] then
		return
	end

	pads[descendant] = nil
end)

--// RESPAWN BLAST
local function respawnBlast(character)
	if respawnRunning then
		return
	end

	respawnRunning = true
	root = character:WaitForChild("HumanoidRootPart", 3)

	if not root then
		respawnRunning = false
		return
	end

	local startTime = os.clock()

	while os.clock() - startTime < RESPAWN_BLAST_TIME do
		if not root or not root.Parent then
			root = character:FindFirstChild("HumanoidRootPart")
		end

		if not root then
			break
		end

		for i = 1, #padList do
			local pad = padList[i]

			if pad and pad.Parent then
				firePad(
					pad,
					RESPAWN_BURSTS,
					RESPAWN_TOUCHES
				)
			end
		end

		if hasRequiredTools() then
			break
		end

		RunService.Heartbeat:Wait()
	end

	respawnRunning = false
end

--// CHARACTER SPAWN
LocalPlayer.CharacterAdded:Connect(function(character)
	task.defer(function()
		respawnBlast(character)
	end)
end)

--// BACKGROUND WARMUP
RunService.Heartbeat:Connect(function()
	if respawnRunning then
		return
	end

	local now = os.clock()

	if HEARTBEAT_INTERVAL > 0 and now - lastHeartbeat < HEARTBEAT_INTERVAL then
		return
	end

	lastHeartbeat = now

	if not root or not root.Parent then
		updateRoot()
	end

	if not root then
		return
	end

	for i = 1, #padList do
		local pad = padList[i]

		if pad and pad.Parent then
			if PAD_TOUCH_RANGE == math.huge
				or (pad.Position - root.Position).Magnitude <= PAD_TOUCH_RANGE then

				firePad(
					pad,
					BACKGROUND_BURSTS,
					BACKGROUND_TOUCHES
				)
			end
		end
	end
end)

print("⚡ Ultra-Instant Tool Grabber initialized.")
