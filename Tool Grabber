-- ⚡ RTX TOOL GRABBER V6 (INSTANT + RESILIENT)

---------------------------------------------------
-- SERVICES
---------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Tycoons = workspace:WaitForChild("Tycoons")

---------------------------------------------------
-- CONFIG
---------------------------------------------------

local PAD_RANGE = 1250
local TOUCH_BURST = 2

local SPAWN_BOOST_TIME = 1.5 -- 🔥 ultra-fast mode after respawn
local SCAN_INTERVAL = 0.08   -- continuous pad refresh

---------------------------------------------------
-- STATE
---------------------------------------------------

local padsByBase = {}

local currentCharacter
local currentRoot

local lastScan = 0
local spawnTime = 0

---------------------------------------------------
-- CHARACTER TRACKING
---------------------------------------------------

local function bindCharacter(char)
	currentCharacter = char
	currentRoot = nil

	if not char then return end

	currentRoot = char:FindFirstChild("HumanoidRootPart")
	if not currentRoot then
		currentRoot = char:WaitForChild("HumanoidRootPart", 5)
	end

	spawnTime = os.clock()

	-- 🔥 immediate burst attempt (no delay wait)
	task.defer(function()
		for _ = 1, 3 do
			task.wait(0.01)
			triggerAcquire()
		end
	end)
end

LocalPlayer.CharacterAdded:Connect(bindCharacter)
if LocalPlayer.Character then
	bindCharacter(LocalPlayer.Character)
end

---------------------------------------------------
-- TOOL CHECK
---------------------------------------------------

local function hasTool(pattern)
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

	if backpack then
		for _, v in ipairs(backpack:GetChildren()) do
			if v:IsA("Tool") and v.Name:find(pattern) then
				return true
			end
		end
	end

	local char = currentCharacter
	if char then
		for _, v in ipairs(char:GetChildren()) do
			if v:IsA("Tool") and v.Name:find(pattern) then
				return true
			end
		end
	end

	return false
end

---------------------------------------------------
-- PAD REGISTER (FAST + SAFE)
---------------------------------------------------

local function registerPad(pad)
	if not pad:IsA("BasePart") then return end
	if not pad:FindFirstChildOfClass("TouchTransmitter") then return end

	local giver = pad.Parent
	if not giver or not giver.Name:find("GearGiver1") then return end

	local base = giver.Parent
	if not base then return end

	local baseName = base.Name

	padsByBase[baseName] = padsByBase[baseName] or {}

	for _, p in ipairs(padsByBase[baseName]) do
		if p == pad then return end
	end

	table.insert(padsByBase[baseName], pad)
end

---------------------------------------------------
-- INITIAL + LIVE SCAN (CONTINUOUS READY STATE)
---------------------------------------------------

for _, obj in ipairs(Tycoons:GetDescendants()) do
	if obj:IsA("BasePart") then
		registerPad(obj)
	end
end

Tycoons.DescendantAdded:Connect(function(obj)
	if obj:IsA("TouchTransmitter") then
		local pad = obj.Parent
		if pad and pad:IsA("BasePart") then
			registerPad(pad)
		end
	end
end)

---------------------------------------------------
-- PAD PICKER (FAST CLEAN)
---------------------------------------------------

local function getClosestPad(baseName)
	local root = currentRoot
	if not root then return nil end

	local pads = padsByBase[baseName]
	if not pads then return nil end

	local closest
	local best = PAD_RANGE

	for i = #pads, 1, -1 do
		local pad = pads[i]

		if not pad or not pad.Parent then
			table.remove(pads, i)
		else
			local dist = (pad.Position - root.Position).Magnitude
			if dist < best then
				best = dist
				closest = pad
			end
		end
	end

	if #pads == 0 then
		padsByBase[baseName] = nil
	end

	return closest
end

---------------------------------------------------
-- TOUCH ENGINE (FAST + LOW LATENCY BURST)
---------------------------------------------------

local function tap(root, pad)
	for _ = 1, TOUCH_BURST do
		firetouchinterest(root, pad, 0)
		firetouchinterest(root, pad, 1)
	end
end

---------------------------------------------------
-- RULES
---------------------------------------------------

local toolRules = {
	{pattern="Energy Sword", base="Stone"},
	{pattern="Staff", base="Magic"},
	{pattern="Axe", base="Storm"},
	{pattern="Fists", base="Robotic"},
	{pattern="Claws", base="ALL"},
	{pattern="Punch", base="Kong"},
}

---------------------------------------------------
-- WAVE BUILDER (SPAWN BOOST AWARE)
---------------------------------------------------

local function buildWave()
	local wave = {}

	for _, rule in ipairs(toolRules) do
		if not hasTool(rule.pattern) then

			if rule.base == "ALL" then
				for baseName in pairs(padsByBase) do
					local pad = getClosestPad(baseName)
					if pad then wave[pad] = true end
				end
			else
				local pad = getClosestPad(rule.base)
				if pad then wave[pad] = true end
			end

		end
	end

	return wave
end

---------------------------------------------------
-- MAIN ENGINE (CONTINUOUS + LOW DELAY)
---------------------------------------------------

function triggerAcquire()
	local now = os.clock()

	-- prevent spam stacking but allow fast respawn bursts
	if triggerAcquire._running then
		return
	end

	triggerAcquire._running = true

	task.spawn(function()
		for _ = 1, 6 do -- 🔥 short burst window instead of long loop

			local root = currentRoot
			if not root then break end

			local wave = buildWave()
			if not next(wave) then break end

			for pad in pairs(wave) do
				if currentRoot then
					tap(currentRoot, pad)
				end
			end

			RunService.Heartbeat:Wait()
		end

		triggerAcquire._running = false
	end)
end

---------------------------------------------------
-- CONTINUOUS BACKGROUND SCANNER (KEY FIX)
---------------------------------------------------

RunService.Heartbeat:Connect(function()
	local now = os.clock()

	-- 🔥 always “ready state scanning” (fixes delay after respawn)
	if now - lastScan > SCAN_INTERVAL then
		lastScan = now

		if currentRoot then
			local wave = buildWave()

			if next(wave) then
				for pad in pairs(wave) do
					tap(currentRoot, pad)
				end
			end
		end
	end

	-- 🔥 spawn boost phase (first seconds = instant acquisition pressure)
	if spawnTime > 0 and (now - spawnTime) < SPAWN_BOOST_TIME then
		triggerAcquire()
	end
end)

---------------------------------------------------
-- STARTUP
---------------------------------------------------

task.defer(triggerAcquire)

print("⚡ RTX Tool Grabber V6 Loaded (Instant + Stable)")
