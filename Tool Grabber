-- ⚡ RTX TOOL GRABBER V4
-- FINAL OPTIMIZED EDITION

---------------------------------------------------
-- SERVICES
---------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Tycoons = workspace:WaitForChild("Tycoons")

---------------------------------------------------
-- CONFIG
---------------------------------------------------

local PAD_RANGE = 1250
local TOUCH_BURST = 2

local ACQUIRE_WINDOW = 1.25

---------------------------------------------------
-- BASE FILTERS
---------------------------------------------------

local allowedBases = {
	Stone=true,
	Magic=true,
	Storm=true,
	Robotic=true,
	Nuclear=true,
	Frozen=true,
	Magma=true,
	Void=true,
	Thunder=true,
	Toxic=true,
	Mecha=true,
	Kong=true,
	Hyper=true,
	Shadow=true
}

local excludedBases = {
	Insanity=true,
	Giant=true,
	Dark=true,
	Spike=true,
	Web=true,
	Strong=true
}

---------------------------------------------------
-- TOOL RULES
---------------------------------------------------

local toolRules = {
	{pattern="Energy Sword", base="Stone"},
	{pattern="Staff", base="Magic"},
	{pattern="Axe", base="Storm"},
	{pattern="Fist", base="Robotic"},

	{pattern="Claws", base="ALL"},
	{pattern="Punch", base="Kong"},
}

---------------------------------------------------
-- STATE
---------------------------------------------------

local padsByBase = {}

local currentCharacter
local currentRoot

local acquisitionActive = false

---------------------------------------------------
-- CHARACTER
---------------------------------------------------

local function bindCharacter(char)

	currentCharacter = char
	currentRoot = nil

	if not char then
		return
	end

	currentRoot = char:FindFirstChild("HumanoidRootPart")

	if not currentRoot then
		task.spawn(function()

			local hrp = char:WaitForChild("HumanoidRootPart",5)

			if currentCharacter == char then
				currentRoot = hrp
			end
		end)
	end
end

if LocalPlayer.Character then
	bindCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(bindCharacter)

---------------------------------------------------
-- TOOL CHECK
---------------------------------------------------

local function hasTool(pattern)

	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

	if backpack then
		for _,v in ipairs(backpack:GetChildren()) do
			if v:IsA("Tool") and string.find(v.Name,pattern) then
				return true
			end
		end
	end

	local char = currentCharacter

	if char then
		for _,v in ipairs(char:GetChildren()) do
			if v:IsA("Tool") and string.find(v.Name,pattern) then
				return true
			end
		end
	end

	return false
end

---------------------------------------------------
-- PAD REGISTRATION
---------------------------------------------------

local function registerPad(pad)

	if not pad:IsA("BasePart") then
		return
	end

	if not pad:FindFirstChildOfClass("TouchTransmitter") then
		return
	end

	local giver = pad.Parent

	if not giver or not giver.Name:find("GearGiver1") then
		return
	end

	local base = giver.Parent

	if not base then
		return
	end

	local baseName = base.Name

	if excludedBases[baseName] then
		return
	end

	if not allowedBases[baseName] then
		return
	end

	padsByBase[baseName] = padsByBase[baseName] or {}

	for _,existing in ipairs(padsByBase[baseName]) do
		if existing == pad then
			return
		end
	end

	table.insert(padsByBase[baseName],pad)
end

---------------------------------------------------
-- INITIAL SCAN
---------------------------------------------------

for _,obj in ipairs(Tycoons:GetDescendants()) do
	if obj:IsA("BasePart") then
		registerPad(obj)
	end
end

---------------------------------------------------
-- LIVE SCAN
---------------------------------------------------

Tycoons.DescendantAdded:Connect(function(obj)

	if obj:IsA("TouchTransmitter") then

		local pad = obj.Parent

		if pad and pad:IsA("BasePart") then

			registerPad(pad)

			-- ⚡ immediate acquisition retry
			task.defer(acquireTools)
		end
	end
end)

---------------------------------------------------
-- CLEANUP + CLOSEST PAD
---------------------------------------------------

local function getClosestPad(baseName)

	local root = currentRoot

	if not root then
		return nil
	end

	local pads = padsByBase[baseName]

	if not pads then
		return nil
	end

	local closest
	local bestDist = PAD_RANGE

	for i = #pads,1,-1 do

		local pad = pads[i]

		if not pad or not pad.Parent then
			table.remove(pads,i)
			continue
		end

		local dist = (pad.Position - root.Position).Magnitude

		if dist < bestDist then
			bestDist = dist
			closest = pad
		end
	end

	-- ⚡ memory cleanup
	if #pads == 0 then
		padsByBase[baseName] = nil
	end

	return closest
end

---------------------------------------------------
-- TOUCH
---------------------------------------------------

local function tap(root,pad)

	for i = 1, TOUCH_BURST do
		firetouchinterest(root,pad,0)
		firetouchinterest(root,pad,1)
	end
end

---------------------------------------------------
-- BUILD PAD WAVE
---------------------------------------------------

local function buildPadWave()

	local wave = {}

	for _,rule in ipairs(toolRules) do

		if not hasTool(rule.pattern) then

			------------------------------------------------
			-- ALL BASES
			------------------------------------------------

			if rule.base == "ALL" then

				for baseName in pairs(padsByBase) do

					local pad = getClosestPad(baseName)

					if pad then
						wave[pad] = true
					end
				end

			------------------------------------------------
			-- SINGLE BASE
			------------------------------------------------

			else

				local pad = getClosestPad(rule.base)

				if pad then
					wave[pad] = true
				end
			end
		end
	end

	return wave
end

---------------------------------------------------
-- ACQUIRE ENGINE
---------------------------------------------------

local function acquireTools()

	if acquisitionActive then
		return
	end

	acquisitionActive = true

	task.spawn(function()

		local t0 = os.clock()

		while os.clock() - t0 < ACQUIRE_WINDOW do

			local root = currentRoot

			if not root then
				RunService.PreSimulation:Wait()
				RunService.PostSimulation:Wait()
				continue
			end

			------------------------------------------------
			-- BUILD ACQUISITION WAVE
			------------------------------------------------

			local wave = buildPadWave()

			------------------------------------------------
			-- COMPLETE CHECK
			------------------------------------------------

			if not next(wave) then
				break
			end

			------------------------------------------------
			-- TOUCH EVERYTHING SAME FRAME
			------------------------------------------------

			for _ = 1, TOUCH_BURST do
				for pad in pairs(wave) do
					tap(root,pad)
				end

				RunService.PreSimulation:Wait()
			end

			RunService.PreSimulation:Wait()
			RunService.PostSimulation:Wait()
		end

		acquisitionActive = false
	end)
end

---------------------------------------------------
-- GUIDE EVENT HOOK
---------------------------------------------------

local GuideEvent = workspace:FindFirstChild("GuideEvent",true)

if GuideEvent and GuideEvent:IsA("RemoteEvent") then

	local old

	old = hookmetamethod(game,"__namecall",function(self,...)

		local method = getnamecallmethod()

		if self == GuideEvent and method == "FireServer" then

			task.defer(acquireTools)
		end

		return old(self,...)
	end)
end

---------------------------------------------------
-- RESPAWN
---------------------------------------------------

LocalPlayer.CharacterAdded:Connect(function()

	task.defer(acquireTools)
end)

---------------------------------------------------
-- INITIAL START
---------------------------------------------------

task.defer(acquireTools)

print("⚡ RTX Tool Grabber V4 Loaded")
