-- ⚡ RTX QUANTUM TOOL GRABBER V3

---------------------------------------------------
-- SERVICES
---------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Tycoons = workspace:WaitForChild("Tycoons")

---------------------------------------------------
-- CONFIG
---------------------------------------------------

local PAD_RANGE = 1250
local TOUCH_BURST = 3

local BURST_TIME = 0.75
local RECOVERY_INTERVAL = 1

---------------------------------------------------
-- BASE FILTERS
---------------------------------------------------

local allowedBases = {
	Stone=true,
	Magic=true,
	Storm=true,
	Robotic=true,
	Nuclear=true,
	Frozen=true,
	Magma=true,
	Void=true,
	Thunder=true,
	Toxic=true,
	Mecha=true,
	Kong=true,
	Hyper=true,
	Shadow=true
}

local excludedBases = {
	Insanity=true,
	Giant=true,
	Dark=true,
	Spike=true,
	Web=true,
	Strong=true
}

---------------------------------------------------
-- TOOL RULES
---------------------------------------------------

local toolRules = {
	{pattern="Energy Sword", base="Stone"},
	{pattern="Staff", base="Magic"},
	{pattern="Axe", base="Storm"},
	{pattern="Fist", base="Robotic"},

	{pattern="Claws", base="ALL"},
	{pattern="Punch", base="Kong"},
}

---------------------------------------------------
-- STATE
---------------------------------------------------

local padsByBase = {}
local activeLoops = {}

local currentCharacter
local currentRoot

---------------------------------------------------
-- CHARACTER TRACKING
---------------------------------------------------

local function bindCharacter(char)

	currentCharacter = char
	currentRoot = nil

	if not char then
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")

	if root then
		currentRoot = root
	else
		task.spawn(function()

			local hrp = char:WaitForChild("HumanoidRootPart",5)

			if currentCharacter == char then
				currentRoot = hrp
			end
		end)
	end
end

if LocalPlayer.Character then
	bindCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(bindCharacter)

---------------------------------------------------
-- TOOL DETECTION
---------------------------------------------------

local function hasTool(pattern)

	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local char = currentCharacter

	if backpack then
		for _,v in ipairs(backpack:GetChildren()) do
			if v:IsA("Tool") and string.find(v.Name,pattern) then
				return true
			end
		end
	end

	if char then
		for _,v in ipairs(char:GetChildren()) do
			if v:IsA("Tool") and string.find(v.Name,pattern) then
				return true
			end
		end
	end

	return false
end

---------------------------------------------------
-- TOUCH
---------------------------------------------------

local function tap(root,pad)

	pcall(firetouchinterest,root,pad,0)
	pcall(firetouchinterest,root,pad,1)

end

---------------------------------------------------
-- PAD REGISTRATION
---------------------------------------------------

local function registerPad(pad)

	if not pad:IsA("BasePart") then
		return
	end

	if not pad:FindFirstChildOfClass("TouchTransmitter") then
		return
	end

	local giver = pad.Parent
	if not giver or not giver.Name:find("GearGiver1") then
		return
	end

	local base = giver.Parent
	if not base then
		return
	end

	local baseName = base.Name

	if excludedBases[baseName] then
		return
	end

	if not allowedBases[baseName] then
		return
	end

	padsByBase[baseName] = padsByBase[baseName] or {}

	-- avoid duplicates
	for _,p in ipairs(padsByBase[baseName]) do
		if p == pad then
			return
		end
	end

	table.insert(padsByBase[baseName],pad)
end

---------------------------------------------------
-- INITIAL PAD SCAN
---------------------------------------------------

for _,obj in ipairs(Tycoons:GetDescendants()) do
	if obj:IsA("BasePart") then
		registerPad(obj)
	end
end

---------------------------------------------------
-- LIVE PAD DETECTION
---------------------------------------------------

Tycoons.DescendantAdded:Connect(function(obj)

	if obj:IsA("BasePart") then
		registerPad(obj)
	end
end)

---------------------------------------------------
-- CLOSEST PAD
---------------------------------------------------

local function getClosestPad(baseName)

	local root = currentRoot

	if not root then
		return nil
	end

	local pads = padsByBase[baseName]

	if not pads then
		return nil
	end

	local closest
	local bestDist = PAD_RANGE

	for i = #pads,1,-1 do

		local pad = pads[i]

		if not pad or not pad.Parent then
			table.remove(pads,i)
			continue
		end

		local dist = (pad.Position - root.Position).Magnitude

		if dist < bestDist then
			bestDist = dist
			closest = pad
		end
	end

	return closest
end

---------------------------------------------------
-- TOOL LOOP
---------------------------------------------------

local function startLoop(rule)

	if activeLoops[rule.pattern] then
		return
	end

	activeLoops[rule.pattern] = true

	task.spawn(function()

		while activeLoops[rule.pattern] do

			if hasTool(rule.pattern) then
				activeLoops[rule.pattern] = nil
				break
			end

			local root = currentRoot

			if not root then
				RunService.Heartbeat:Wait()
				continue
			end

			------------------------------------------------
			-- ALL BASES
			------------------------------------------------

			if rule.base == "ALL" then

				for baseName in pairs(padsByBase) do

					local pad = getClosestPad(baseName)

					if pad then
						for i = 1, TOUCH_BURST do
							tap(root,pad)
						end
					end
				end

			------------------------------------------------
			-- SINGLE BASE
			------------------------------------------------

			else

				local pad = getClosestPad(rule.base)

				if pad then
					for i = 1, TOUCH_BURST do
						tap(root,pad)
					end
				end
			end

			RunService.Heartbeat:Wait()
		end
	end)
end

---------------------------------------------------
-- START ALL
---------------------------------------------------

local function startAll()

	for _,rule in ipairs(toolRules) do

		if not hasTool(rule.pattern) then
			startLoop(rule)
		end
	end
end

---------------------------------------------------
-- ⚡ GUIDE EVENT BURST
---------------------------------------------------

local function burstWindow()

	task.spawn(function()

		local t0 = os.clock()

		while os.clock() - t0 < BURST_TIME do

			startAll()

			RunService.Heartbeat:Wait()
		end
	end)
end

---------------------------------------------------
-- GUIDE EVENT HOOK
---------------------------------------------------

local GuideEvent = workspace:FindFirstChild("GuideEvent",true)

if GuideEvent and GuideEvent:IsA("RemoteEvent") then

	local old
	old = hookmetamethod(game,"__namecall",function(self,...)

		local method = getnamecallmethod()

		if self == GuideEvent and method == "FireServer" then

			task.defer(function()

				-- starts BEFORE respawn fully settles
				burstWindow()

			end)
		end

		return old(self,...)
	end)
end

---------------------------------------------------
-- CHARACTERADDED FALLBACK
---------------------------------------------------

LocalPlayer.CharacterAdded:Connect(function()

	-- reset dead loops
	table.clear(activeLoops)

	burstWindow()
end)

---------------------------------------------------
-- AUTO RECOVERY
---------------------------------------------------

task.spawn(function()

	while true do

		for _,rule in ipairs(toolRules) do

			if not hasTool(rule.pattern) then

				if not activeLoops[rule.pattern] then
					startLoop(rule)
				end
			end
		end

		task.wait(RECOVERY_INTERVAL)
	end
end)

---------------------------------------------------
-- INITIAL START
---------------------------------------------------

startAll()

print("⚡ RTX Quantum Tool Grabber V3 Loaded")
