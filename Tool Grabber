-- ⚡ SMART BURST TOOL GRABBER (ULTRA OPTIMIZED)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Tycoons = workspace:WaitForChild("Tycoons")

-- CONFIG
local RESPAWN_TIME = 0
local TOUCHES_PER_PAD = 6
local BACKGROUND_TOUCHES = 2
local PAD_RANGE = 1000
local CYCLE_DELAY = 0

local allowedBases = {Stone=true, Magic=true, Storm=true, Robotic=true}
local excludedBases = {Insanity=true, Giant=true, Dark=true, Spike=true, Web=true, Strong=true}

local requiredTools = {
	["Energy Sword"]=true,
	["Fist"]=true,
	["Staff"]=true,
	["Axe"]=true,
}

-- internals
local pads = {}
local padIndex = 1
local grabbing = false

-- register pads
local function register(pad)
	local base = pad.Parent and pad.Parent.Parent
	if not base then return end
	if excludedBases[base.Name] then return end
	if not allowedBases[base.Name] then return end

	for _,p in ipairs(pads) do
		if p == pad then return end
	end

	table.insert(pads,pad)
end

for _,d in ipairs(Tycoons:GetDescendants()) do
	if d:IsA("TouchTransmitter") and d.Parent and d.Parent.Parent and d.Parent.Parent.Name:find("GearGiver1") then
		register(d.Parent)
	end
end

Tycoons.DescendantAdded:Connect(function(d)
	if d:IsA("TouchTransmitter") and d.Parent and d.Parent.Parent and d.Parent.Parent.Name:find("GearGiver1") then
		register(d.Parent)
	end
end)

-- tool check
local function haveTools()
	local found = {}

	local function scan(c)
		if not c then return end
		for _,t in ipairs(c:GetChildren()) do
			if t:IsA("Tool") and requiredTools[t.Name] then
				found[t.Name]=true
			end
		end
	end

	scan(player.Backpack)
	scan(player.Character)

	for name in pairs(requiredTools) do
		if not found[name] then
			return false
		end
	end

	return true
end

-- touch
local function tap(root,pad)
	pcall(firetouchinterest,root,pad,0)
	pcall(firetouchinterest,root,pad,1)
end

-- respawn grab burst
local function respawnGrab()

	grabbing = true

	local char = player.Character
	if not char then grabbing=false return end

	local root = char:WaitForChild("HumanoidRootPart",2)
	if not root then grabbing=false return end

	local t0 = os.clock()

	while os.clock()-t0 < RESPAWN_TIME do

		if haveTools() then break end

		local pad = pads[padIndex]
		padIndex += 1
		if padIndex > #pads then padIndex = 1 end

		if pad and (pad.Position-root.Position).Magnitude < PAD_RANGE then
			for i=1,TOUCHES_PER_PAD do
				tap(root,pad)
			end
		end

		task.wait(CYCLE_DELAY)

	end

	grabbing = false

end

player.CharacterAdded:Connect(function()
	task.spawn(respawnGrab)
end)

-- background warming
RunService.Heartbeat:Connect(function()

	if grabbing then return end

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local pad = pads[padIndex]
	padIndex += 1
	if padIndex > #pads then padIndex = 1 end

	if pad and (pad.Position-root.Position).Magnitude < PAD_RANGE then
		for i=1,BACKGROUND_TOUCHES do
			tap(root,pad)
		end
	end

end)

print("⚡ Smart Burst Tool Grabber Loaded")
