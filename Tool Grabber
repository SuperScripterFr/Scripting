-- ⚡ QUANTUM INSTANT PARALLEL TOOL GRABBER

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Tycoons = workspace:WaitForChild("Tycoons")

-- CONFIG
local PAD_RANGE = 1000
local TOUCH_BURST = 8 -- touches per frame per pad

local allowedBases = {Stone=true, Magic=true, Storm=true, Robotic=true}
local excludedBases = {Insanity=true, Giant=true, Dark=true, Spike=true, Web=true, Strong=true}

-- TOOL -> BASE MAPPING
local toolToBase = {
	["Energy Sword"] = "Stone",
	["Staff"] = "Magic",
	["Axe"] = "Storm",
	["Fist"] = "Robotic",
}

-- internals
local padsByBase = {}
local activeLoops = {}

--==================================================
-- 🔍 PAD REGISTRATION
--==================================================

local function register(pad)

	local base = pad.Parent and pad.Parent.Parent
	if not base then return end

	if excludedBases[base.Name] then return end
	if not allowedBases[base.Name] then return end

	padsByBase[base.Name] = padsByBase[base.Name] or {}

	table.insert(padsByBase[base.Name], pad)

end

for _, tycoon in ipairs(Tycoons:GetChildren()) do
	for _, folder in ipairs(tycoon:GetChildren()) do
		if folder.Name:find("GearGiver1") then
			for _, pad in ipairs(folder:GetChildren()) do
				if pad:IsA("BasePart") then
					local touch = pad:FindFirstChildOfClass("TouchTransmitter")
					if touch then
						register(pad)
					end
				end
			end
		end
	end
end

Tycoons.DescendantAdded:Connect(function(d)
	if not d:IsA("TouchTransmitter") then return end

	local parent = d.Parent
	local container = parent and parent.Parent

	if container and container.Name:find("GearGiver1") then
		register(parent)
	end
end)

--==================================================
-- 🧠 TOOL DETECTION
--==================================================

local function hasTool(toolName)

	local function scan(container)
		if not container then return false end
		for _,t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and t.Name == toolName then
				return true
			end
		end
	end

	return scan(player.Backpack) or scan(player.Character)

end

--==================================================
-- ⚡ TOUCH FUNCTION
--==================================================

local function tap(root,pad)
	pcall(firetouchinterest,root,pad,0)
	pcall(firetouchinterest,root,pad,1)
end

--==================================================
-- 🎯 CLOSEST PAD FINDER (NEW)
--==================================================

local function getClosestPad(pads, root)
	local closest, dist

	for _, pad in ipairs(pads) do
		local d = (pad.Position - root.Position).Magnitude
		if d < PAD_RANGE and (not dist or d < dist) then
			dist = d
			closest = pad
		end
	end

	return closest
end

--==================================================
-- 🚀 PER-TOOL PARALLEL LOOP
--==================================================

local function startToolLoop(toolName)

	if activeLoops[toolName] then return end

	local base = toolToBase[toolName]
	if not base then return end

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not root then return end

	activeLoops[toolName] = true

	task.spawn(function()

		while activeLoops[toolName] do

			-- STOP INSTANTLY IF TOOL ACQUIRED
			if hasTool(toolName) then
				activeLoops[toolName] = nil
				break
			end

			local pads = padsByBase[base]

			if pads then
				local pad = getClosestPad(pads, root)
				if pad then
					for i = 1, TOUCH_BURST do
						tap(root, pad)
					end
				end
			end

			RunService.PreSimulation:Wait()
			RunService.Heartbeat:Wait()
		end

	end)

end

--==================================================
-- 🔄 RESPAWN TRIGGER
--==================================================

local function instantStart()
	for toolName in pairs(toolToBase) do
		startToolLoop(toolName)
	end
end

local function startGrab()

	for toolName in pairs(toolToBase) do
		startToolLoop(toolName)
	end

end

local SpawnDeltWith = false

task.spawn(function()

	local lastChar = nil

	while true do
		local char = player.Character

		if char and char ~= lastChar then
			lastChar = char
			SpawnDeltWith = false

			-- ⚡ fires slightly earlier than CharacterAdded
			task.spawn(function()
				if SpawnDeltWith then return end
				SpawnDeltWith = true
				instantStart()
			end)
		end
		RunService.PreSimulation:Wait()
		RunService.Heartbeat:Wait()
	end
end)

-- ChacterAdded fallback incase above method fails
player.CharacterAdded:Connect(function(char)
	if SpawnDeltWith then return end
	SpawnDeltWith = true
	instantStart() -- start immediately
end)

-- also run immediately if already spawned
if player.Character then
	startGrab()
end

print("⚡ Quantum Instant Tool Grabber Loaded")
