----------------------------------------------------------------
-- UI FEEDBACK
----------------------------------------------------------------
toggle.MouseEnter:Connect(function()
	TweenService:Create(toggle, ANIM, {
		Size = UDim2.fromOffset(190, 70)
	}):Play()

	TweenService:Create(glow, ANIM, {
		Transparency = 0.25
	}):Play()
end)

toggle.MouseLeave:Connect(function()
	TweenService:Create(toggle, ANIM, {
		Size = UDim2.fromOffset(180, 64)
	}):Play()

	TweenService:Create(glow, ANIM, {
		Transparency = 0.6
	}):Play()
end)

----------------------------------------------------------------
-- TOGGLE LOGIC
----------------------------------------------------------------
local function updateText()
	toggle.Text = active and "USE TOOLS: ON" or "USE TOOLS: OFF"
end

local function setState(state)
	active = state
	updateText()

	if active then
		equipTools()
	else
		unequipTools()
	end
end

toggle.MouseButton1Click:Connect(function()
	setState(not active)
end)

UIS.InputBegan:Connect(function(i,g)
	if not g and i.KeyCode == Enum.KeyCode.Q then
		setState(not active)
	end
end)

updateText()
print("[RTX] Use Tools initialized")		
