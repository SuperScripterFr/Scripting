local function round(i,r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 14)
	c.Parent = i
end

local function stroke(i, thick)
	local s = Instance.new("UIStroke")
	s.Color = Theme.Stroke
	s.Thickness = thick or 1
	s.Parent = i
end

----------------------------------------------------------------
-- CONFIG — SAFE MAX POWER
----------------------------------------------------------------
local ACTIVATIONS_PER_SECOND = 70  -- Slightly stronger than before
local EQUIP_REFRESH_RATE     = 0

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local active          = false
local pulseAccum     = 0
local equipAccum     = 0
local pulseInterval  = 1 / ACTIVATIONS_PER_SECOND

----------------------------------------------------------------
-- TOOL LOGIC (HEADLESS)
----------------------------------------------------------------
local function equipTools()
	local char, bp = player.Character, player.Backpack
	if not char or not bp then return end

	for _, t in ipairs(bp:GetChildren()) do
		if t:IsA("Tool") and t.Parent ~= char then
			t.Parent = char
		end
	end
end

local function unequipTools()
	local char, bp = player.Character, player.Backpack
	if not char or not bp then return end

	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			t.Parent = bp
		end
	end
end

local function activateTools()
	local char = player.Character
	if not char then return end

	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			pcall(t.Activate, t)
		end
	end
end

----------------------------------------------------------------
-- ENGINE LOOP (STABILIZED)
----------------------------------------------------------------
local BURST_RATE = 0.12
local BURST_DURATION = 0.1

local lastBurst = 0
local bursting = false

RunService.PreSimulation:Connect(function()
	if not active then return end

	local now = os.clock()

	if not bursting and (now - lastBurst) > BURST_RATE then
		bursting = true
		lastBurst = now

		local endTime = now + BURST_DURATION
		
		task.spawn(function()
			while os.clock() < endTime do
				activateTools()
				RunService.Heartbeat:Wait()
			end
			bursting = false
		end)
	end
end)

