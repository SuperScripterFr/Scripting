	TweenService:Create(toggle, ANIM, { Size = UDim2.fromOffset(180, 64) }):Play()
	TweenService:Create(glow, ANIM, { Transparency = 0.6 }):Play()
end)

local function updateText()
	toggle.Text = active and "USE TOOLS: ON" or "USE TOOLS: OFF"
end

local function setState(state)
	active = state
	updateText()
	if active then
		equipTools(true)
		task.defer(function()
			RunService.Heartbeat:Wait()
			if active then
				refreshTools()
				recaptureDropped()
				stabilizeHandles()
				damagePulse()
			end
		end)
	else
		unequipTools()
	end
end

toggle.MouseButton1Click:Connect(function()
	setState(not active)
end)
UIS.InputBegan:Connect(function(i, g)
	if g then return end
	if i.KeyCode == TOGGLE_KEY then setState(not active) end
end)

updateText()
print("⚡ RTX Use Tools V7 Loaded (90Hz hyper)")
