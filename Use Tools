----------------------------------------------------------------
-- SERVICES
----------------------------------------------------------------
local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local UIS          = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

----------------------------------------------------------------
-- THEME (MATCHES RTX HUB)
----------------------------------------------------------------
local Theme = {
	Accent = Color3.fromRGB(0,0,255),
	Glass  = Color3.fromRGB(0,0,50),
	Text   = Color3.fromRGB(255,255,255),
	Stroke = Color3.fromRGB(0,0,255)
}

local ANIM = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function round(i,r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 14)
	c.Parent = i
end

local function stroke(i, thick)
	local s = Instance.new("UIStroke")
	s.Color = Theme.Stroke
	s.Thickness = thick or 1
	s.Parent = i
end

----------------------------------------------------------------
-- CONFIG — SAFE MAX POWER
----------------------------------------------------------------
local ACTIVATIONS_PER_SECOND = 25
local EQUIP_REFRESH_RATE     = 0

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local active          = false
local pulseAccum     = 0
local equipAccum     = 0
local pulseInterval  = 1 / ACTIVATIONS_PER_SECOND

----------------------------------------------------------------
-- TOOL LOGIC (HEADLESS)
----------------------------------------------------------------
local function equipTools()
	local char, bp = player.Character, player.Backpack
	if not char or not bp then return end

	for _, t in ipairs(bp:GetChildren()) do
		if t:IsA("Tool") then
			t.Parent = char
		end
	end
end

local function unequipTools()
	local char, bp = player.Character, player.Backpack
	if not char or not bp then return end

	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			t.Parent = bp
		end
	end
end

local MAX_PARALLEL = 6
local activeThreads = 0

local function activateTools()
	local char = player.Character
	if not char then return end

	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then

			if activeThreads < MAX_PARALLEL then
				activeThreads += 1

				task.spawn(function()
					pcall(t.Activate, t)
					activeThreads -= 1
				end)
			end
			pcall(t.Activate, t)
		end
	end
end

----------------------------------------------------------------
-- ⚡ FRAME-SYNCED ENGINE (OPTIMIZED)
----------------------------------------------------------------
local function onSpawn(char)
    equipTools()
    activateTools()

    -- 1–2 frame follow-up (keeps it tight)
    task.defer(function()
        activateTools()
        RunService.PreSimulation:Wait()
        activateTools()
    end)
end

-- Early detection (often fires slightly before CharacterAdded logic finishes)
task.spawn(function()
    local last
    while true do
        local c = player.Character
        if c and c ~= last then
            last = c
            if active then
                onSpawn(c)
            end
        end
        RunService.PreSimulation:Wait()
    end
end)

-- Fallback (guaranteed)
player.CharacterAdded:Connect(function(c)
    if active then
        onSpawn(c)
    end
end)

----------------------------------------------------------------
-- UI — GLASS TOGGLE
----------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "RTXUseTools"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Global
gui.Parent = game:GetService("CoreGui")

local toggle = Instance.new("TextButton", gui)
toggle.Size = UDim2.fromOffset(180, 64)
toggle.Position = UDim2.fromScale(0.98, 0.55)
toggle.AnchorPoint = Vector2.new(1,0.5)
toggle.Text = "USE TOOLS: OFF"
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 15
toggle.TextColor3 = Theme.Text
toggle.BackgroundColor3 = Theme.Glass
toggle.BackgroundTransparency = 0.08
toggle.AutoButtonColor = false
toggle.Active = true
toggle.Draggable = true
toggle.ZIndex = 9999

round(toggle,16)
stroke(toggle,2)

local glow = Instance.new("UIStroke", toggle)
glow.Color = Theme.Accent
glow.Thickness = 2
