--=========================================
-- VARIABLES
--=========================================
local isActive = false
local noclipConnection = nil

--=========================================
-- FUNCTIONS
--=========================================
local function toggleNoclip(enabled)
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    if enabled then
        noclipConnection = RunService.Stepped:Connect(function()
            if player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

local function animateButton(on)
    local goal = {BackgroundColor3 = on and Color3.fromRGB(35,35,35) or Color3.fromRGB(25,25,25)}
    TweenService:Create(toolButton, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
end

local function toggleButton()
    isActive = not isActive
    if isActive then
        toolButton.Text = "On"
        toggleNoclip(true)
        animateButton(true)
    else
        toolButton.Text = "Off"
        toggleNoclip(false)
        if player.Character then
            for _, tool in ipairs(player.Character:GetChildren()) do
                if tool:IsA("Tool") then
                    tool.Parent = player.Backpack
                end
            end
        end
        animateButton(false)
    end
end

toolButton.MouseButton1Click:Connect(toggleButton)
toolButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        toggleButton()
    end
end)

--=========================================
-- ⚡ USE TOOLS V10 (LIVE SCAN ENGINE)
--=========================================

local RATE = 6 -- activations per tick

if _G.UltraTick then

	_G.UltraTick.Bind(function()

		if not isActive then return end

		local char = player.Character
		if not char then return end

		local backpack = player:FindFirstChild("Backpack")

		-- force equip real tools only
		if backpack then
			for _,tool in ipairs(backpack:GetChildren()) do
				if tool:IsA("Tool") then
					tool.Parent = char
				end
			end
		end

		-- activate equipped tools
		for _,tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool") then

				for i = 1,RATE do
					pcall(tool.Activate, tool)
				end

				-- ⭐ hybrid remote boost (optional)
				local remote = tool:FindFirstChild("FightEvent")
				if remote then
					remote:FireServer()
				end

			end
		end

	end)

end

--=========================================
-- DRAGGABLE LIMIT
--=========================================
local dragging = false
local dragInput, mousePos, framePos

toolButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        mousePos = input.Position
        framePos = buttonFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

toolButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - mousePos
        local newX = math.clamp(framePos.X.Offset + delta.X, 0, workspace.CurrentCamera.ViewportSize.X - buttonFrame.AbsoluteSize.X)
        local newY = math.clamp(framePos.Y.Offset + delta.Y, 0, workspace.CurrentCamera.ViewportSize.Y - buttonFrame.AbsoluteSize.Y)
        buttonFrame.Position = UDim2.new(framePos.X.Scale, newX, framePos.Y.Scale, newY)
    end
end)

--=========================================
-- KEYBIND TOGGLE
--=========================================
local TOGGLE_KEY = Enum.KeyCode.E -- Change this to whatever you want
local keyDebounce = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == TOGGLE_KEY and not keyDebounce then
        keyDebounce = true
        toggleButton()
        task.wait(0.15) -- prevents spam from holding key
        keyDebounce = false
    end
end)
