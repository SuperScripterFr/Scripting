	TweenService:Create(toggle,ANIM,{
		Size = UDim2.fromOffset(190,70)
	}):Play()

	TweenService:Create(glow,ANIM,{
		Transparency = 0.25
	}):Play()
end)

toggle.MouseLeave:Connect(function()

	TweenService:Create(toggle,ANIM,{
		Size = UDim2.fromOffset(180,64)
	}):Play()

	TweenService:Create(glow,ANIM,{
		Transparency = 0.6
	}):Play()
end)

------------------------------------------------------------
-- TEXT
------------------------------------------------------------

local function updateText()
	toggle.Text = active and "USE TOOLS: ON" or "USE TOOLS: OFF"
end

------------------------------------------------------------
-- TOGGLE
------------------------------------------------------------

local function setState(state)

	active = state

	updateText()

	if active then

		-- ⚡ instant equip
		equipTools(true)

		-- ⚡ stable first pulse
		task.defer(function()

			RunService.Heartbeat:Wait()

			if active then
				refreshTools()
				damagePulse()
			end
		end)

	else

		unequipTools()
	end
end

------------------------------------------------------------
-- INPUT
------------------------------------------------------------

toggle.MouseButton1Click:Connect(function()
	setState(not active)
end)

UIS.InputBegan:Connect(function(i,g)

	if g then
		return
	end

	if i.KeyCode == Enum.KeyCode.E then
		setState(not active)
	end
end)

------------------------------------------------------------
-- INIT
------------------------------------------------------------

updateText()

print("⚡ RTX Use Tools V5 Loaded")
