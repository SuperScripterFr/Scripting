----------------------------------------------------------------
-- SERVICES
----------------------------------------------------------------
local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local UIS          = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

----------------------------------------------------------------
-- THEME (NEON BLUE CYBER STYLE)
----------------------------------------------------------------
local Theme = {
	Accent = Color3.fromRGB(80,180,255),
	Accent2 = Color3.fromRGB(0,140,255),
	Glass  = Color3.fromRGB(10,14,20),
	Text   = Color3.fromRGB(220,240,255),
	Stroke = Color3.fromRGB(80,200,255)
}

local ANIM = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

----------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------
local function round(i,r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 14)
	c.Parent = i
end

local function stroke(i, thick, color)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Stroke
	s.Thickness = thick or 1
	s.Transparency = 0.3
	s.Parent = i
end

----------------------------------------------------------------
-- CONFIG (SAFE MAX POWER)
----------------------------------------------------------------
local ACTIVATIONS_PER_SECOND = 150
local EQUIP_REFRESH_RATE     = 0
local MAX_ACTIVATIONS_PER_FRAME = 6 -- prevents lag spikes

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local active = false
local pulseAccum = 0
local equipAccum = 0
local pulseInterval = 1 / ACTIVATIONS_PER_SECOND

----------------------------------------------------------------
-- TOOL CACHE (BIG PERFORMANCE WIN)
----------------------------------------------------------------
local cachedTools = {}

local function refreshToolCache()
	local char = player.Character
	cachedTools = {}

	if not char then return end

	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			table.insert(cachedTools, t)
		end
	end
end

----------------------------------------------------------------
-- TOOL LOGIC
----------------------------------------------------------------
local function equipTools()
	local char, bp = player.Character, player.Backpack
	if not char or not bp then return end

	for _, t in ipairs(bp:GetChildren()) do
		if t:IsA("Tool") then
			t.Parent = char
		end
	end

	refreshToolCache()
end

local function unequipTools()
	local char, bp = player.Character, player.Backpack
	if not char or not bp then return end

	for _, t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			t.Parent = bp
		end
	end

	refreshToolCache()
end

local function activateTools()
	-- limit activations per frame (prevents lag spikes)
	local count = 0

	for _, t in ipairs(cachedTools) do
		if count >= MAX_ACTIVATIONS_PER_FRAME then break end
		if t and t.Parent then
			pcall(function()
				t:Activate()
			end)
			count += 1
		end
	end
end

----------------------------------------------------------------
-- ENGINE LOOP (STABILIZED)
----------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	if not active then return end

	-- clamp dt for safety against frame drops
	dt = math.clamp(dt, 0, 0.1)

	equipAccum += dt
	if equipAccum >= EQUIP_REFRESH_RATE then
		equipAccum = 0
		equipTools()
	end
end)

RunService.PreSimulation:Connect(function(dt)
	if not active then return end

	dt = math.clamp(dt, 0, 0.1)

	pulseAccum += dt
	while pulseAccum >= pulseInterval do
		pulseAccum -= pulseInterval
		activateTools()
	end
end)

----------------------------------------------------------------
-- UI — CYBER NEON PANEL
----------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "RTXUseTools"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local toggle = Instance.new("TextButton")
toggle.Size = UDim2.fromOffset(200, 70)
toggle.Position = UDim2.fromScale(0.98, 0.55)
toggle.AnchorPoint = Vector2.new(1,0.5)
toggle.Text = "TOOLS: OFF"
toggle.Font = Enum.Font.GothamBold
toggle.TextSize = 16
toggle.TextColor3 = Theme.Text
toggle.BackgroundColor3 = Theme.Glass
toggle.BackgroundTransparency = 0.1
toggle.AutoButtonColor = false
toggle.Parent = gui
toggle.ZIndex = 10
toggle.Active = true
toggle.Draggable = true

round(toggle, 16)
stroke(toggle, 2)

-- gradient glow
local grad = Instance.new("UIGradient")
grad.Color = ColorSequence.new{
	ColorSequenceKeypoint.new(0, Theme.Accent),
	ColorSequenceKeypoint.new(1, Theme.Accent2)
}
grad.Rotation = 45
grad.Parent = toggle

-- animated glow
local glow = Instance.new("UIStroke")
glow.Color = Theme.Accent
glow.Thickness = 2
glow.Transparency = 0.4
glow.Parent = toggle

----------------------------------------------------------------
-- UI ANIMATION LOOP (NEON PULSE)
----------------------------------------------------------------
task.spawn(function()
	while true do
		if active then
			TweenService:Create(glow, TweenInfo.new(1), {
				Transparency = 0.15
			}):Play()
		else
			TweenService:Create(glow, TweenInfo.new(1), {
				Transparency = 0.6
			}):Play()
		end
		task.wait(1)
	end
end)

----------------------------------------------------------------
-- UI FEEDBACK
----------------------------------------------------------------
toggle.MouseEnter:Connect(function()
	TweenService:Create(toggle, ANIM, {
		Size = UDim2.fromOffset(210, 76)
	}):Play()
end)

toggle.MouseLeave:Connect(function()
	TweenService:Create(toggle, ANIM, {
		Size = UDim2.fromOffset(200, 70)
	}):Play()
end)

----------------------------------------------------------------
-- TOGGLE LOGIC
----------------------------------------------------------------
local function updateText()
	toggle.Text = active and "TOOLS: ON" or "TOOLS: OFF"
end

local function primeActivation()
	refreshToolCache()
	activateTools() -- fire immediately once
end

local function setState(state)
	active = state
	updateText()

	if active then
		equipTools()
		task.defer(primeActivation) -- immediate burst after equip
	else
		unequipTools()
	end
end

toggle.MouseButton1Click:Connect(function()
	setState(not active)
end)

UIS.InputBegan:Connect(function(i,g)
	if not g and i.KeyCode == Enum.KeyCode.E then
		setState(not active)
	end
end)

----------------------------------------------------------------
-- RESPAWN SAFETY
----------------------------------------------------------------
player.CharacterAdded:Connect(function()
	task.wait(0) -- small stabilization (important)
	if active then
		equipTools()
		task.defer(primeActivation)
	end
end)

updateText()
print("[RTX] Upgraded Use Tools initialized")
