-- ============ CONFIG ============
getgenv().SPT_UseTools = getgenv().SPT_UseTools or {}
local G = getgenv().SPT_UseTools

local APS                  = typeof(G.APS) == "number" and G.APS or 90
local PULSE_INTERVAL       = 1 / APS
local RESPAWN_BURST_TIME   = 2.0
local TOUCH_ASSIST_RANGE   = 16
local TOUCH_ASSIST_BURST   = 2
local TOGGLE_KEY           = Enum.KeyCode.E

-- cosmetic fan slots for the local-only stabilizer welds (never replicated to the server)
local HAND_OFFSETS = {
	CFrame.new(0.62, 0.85, -0.55),
	CFrame.new(-0.62, 0.85, -0.55),
	CFrame.new(0.58, 0.35, -0.15),
	CFrame.new(-0.58, 0.35, -0.15),
	CFrame.new(0, 0.95, -0.95),
	CFrame.new(0, 0.42, -0.95),
}

-- ============ STATE ============
local active = false
local toolsCache = {}
local touchParts = {}    -- tool -> touch part
local remoteCache = {}   -- tool -> FightEvent remote

local currentCharacter
local currentRoot

local lastPulse = 0
local lastEquipCheck = 0
local EQUIP_INTERVAL = 1 / 20
local burstActive = false

local lastTargetScan = 0
local cachedTarget
local wantedTools = {}   -- every Tool we intend to keep equipped (for re-capture)

-- ============ TOOL CACHE ============
local function refreshTools()
	table.clear(toolsCache)
	table.clear(touchParts)
	table.clear(remoteCache)
	local char = currentCharacter
	if not char then return end
	for _, o in ipairs(char:GetChildren()) do
		if o:IsA("Tool") then
			toolsCache[#toolsCache + 1] = o
			local tx = o:FindFirstChildWhichIsA("TouchTransmitter", true)
			local part = tx and tx.Parent
			if part and part:IsA("BasePart") then touchParts[o] = part end
			local rem = o:FindFirstChild("FightEvent")
			if rem then remoteCache[o] = rem end
		end
	end
end

-- ============ CHARACTER (respawn-safe) ============
local epoch = 0
local function bindCharacter(char)
	epoch += 1
	local myEpoch = epoch
	currentCharacter = char
	currentRoot = nil
	if not char then return end
	local r = char:FindFirstChild("HumanoidRootPart")
	if not r then r = char:WaitForChild("HumanoidRootPart", 5) end
	if epoch == myEpoch and r then currentRoot = r end
	refreshTools()
end

-- ============ EQUIP / UNEQUIP ============
local function equipTools(force)
	local now = os.clock()
	if not force and now - lastEquipCheck < EQUIP_INTERVAL then return end
	lastEquipCheck = now

	local char = currentCharacter
	local bp = player:FindFirstChildOfClass("Backpack")
	if not char or not bp then return end

	local changed = false
	table.clear(wantedTools)
	for _, tool in ipairs(bp:GetChildren()) do
		if tool:IsA("Tool") then
			tool.Parent = char
			changed = true
			wantedTools[#wantedTools + 1] = tool
		end
	end
	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then wantedTools[#wantedTools + 1] = tool end
	end
	if changed then refreshTools() end
end

local function unequipTools()
	local char = currentCharacter
	local bp = player:FindFirstChildOfClass("Backpack")
	if not char or not bp then return end
	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then tool.Parent = bp end
	end
	clearStabilizers()
	table.clear(toolsCache)
	table.clear(touchParts)
	table.clear(remoteCache)
	table.clear(wantedTools)
end

-- ============ HANDLE STABILIZER (keeps every tool visually welded) ============
local function getToolHandle(tool)
	if not tool then return nil end
	return tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
end

local function clearStabilizers()
	for i = 1, #toolsCache do
		local h = getToolHandle(toolsCache[i])
		local w = h and h:FindFirstChild("SPTStabilizer")
		if w then w:Destroy() end
	end
end

-- if the engine fully drops a tool into the workspace, bring it back into the rig
local function recaptureDropped()
	local char = currentCharacter
	if not char then return end
	local bp = player:FindFirstChildOfClass("Backpack")
	for i = 1, #wantedTools do
		local tool = wantedTools[i]
		if tool and tool.Parent and tool.Parent ~= char and tool.Parent ~= bp then
			pcall(function() tool.Parent = char end)
		end
	end
end

-- weld every handle to the HumanoidRootPart so the client always renders them in-hand
local function stabilizeHandles()
	local root = currentRoot
	if not root or not root.Parent then return end
	for i = 1, #toolsCache do
		local tool = toolsCache[i]
		if tool and tool.Parent then
			local handle = getToolHandle(tool)
			if handle and not handle.Anchored then
				handle.CanCollide = false
				handle.Massless = true
				local w = handle:FindFirstChild("SPTStabilizer")
				if not w then
					local rel = root.CFrame:ToObjectSpace(handle.CFrame)
					local c0 = HAND_OFFSETS[(i - 1) % #HAND_OFFSETS + 1]
					if rel.Position.Magnitude < 4 then c0 = rel end  -- keep natural hand pose if still in-hand
					w = Instance.new("Weld")
					w.Name = "SPTStabilizer"
					w.Part0 = root
					w.Part1 = handle
					w.C0 = c0
					w.C1 = CFrame.new()
					w.Parent = handle
				elseif w.Part0 ~= root or w.Part1 ~= handle then
					w.Part0 = root
					w.Part1 = handle
				end
			end
		end
	end
end

-- ============ TARGET (cached every 100ms) ============
local function getTarget()
	if os.clock() - lastTargetScan < 0.1 then return cachedTarget end
	lastTargetScan = os.clock()
	local myRoot = currentRoot
	if not myRoot then cachedTarget = nil return nil end
	local myPos = myRoot.Position
	local bestRoot, bestSq = nil, TOUCH_ASSIST_RANGE * TOUCH_ASSIST_RANGE
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local char = plr.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local r = char:FindFirstChild("HumanoidRootPart")
				if hum and r and hum.Health > 0 then
					local dx, dy, dz = r.Position.X - myPos.X, r.Position.Y - myPos.Y, r.Position.Z - myPos.Z
					local dsq = dx * dx + dy * dy + dz * dz
					if dsq < bestSq then
						bestSq = dsq
						bestRoot = r
					end
				end
			end
		end
	end
	cachedTarget = bestRoot
	return bestRoot
end

-- ============ DAMAGE CORE ============
local function damagePulse()
	-- 1) activate every equipped tool
	for i = 1, #toolsCache do
		local t = toolsCache[i]
		if t and t.Parent then pcall(t.Activate, t) end
	end

	-- 2) touch assist on nearest target
	local target = getTarget()
	if target then
		for i = 1, #toolsCache do
			local tp = touchParts[toolsCache[i]]
			if tp and tp.Parent then
				for _ = 1, TOUCH_ASSIST_BURST do
					firetouchinterest(tp, target, 0)
					firetouchinterest(tp, target, 1)
				end
			end
		end
		-- 3) remote burst for guaranteed hits
		for _, rem in pairs(remoteCache) do
			if rem and rem.Parent then
				pcall(rem.FireServer, rem, target)
			end
		end
	end
end
-- ============ RESPAWN BURST ============
local function beginBurst()
	if burstActive then return end
	burstActive = true
	task.spawn(function()
		local t0 = os.clock()
		equipTools(true)
		stabilizeHandles()
		RunService.Heartbeat:Wait()
		while active and os.clock() - t0 < RESPAWN_BURST_TIME do
			equipTools(true)
			recaptureDropped()
			stabilizeHandles()
			damagePulse()
			RunService.Heartbeat:Wait()
		end
		burstActive = false
	end)
end

-- ============ MAIN ENGINE ============
RunService.Stepped:Connect(function()
	if not active then return end
	local now = os.clock()
	if now - lastPulse < PULSE_INTERVAL then return end
	lastPulse = now
	equipTools()
	recaptureDropped()
	stabilizeHandles()
	damagePulse()
end)

-- ============ RESPAWN ============
player.CharacterAdded:Connect(function()
	if not active then return end
	task.defer(function()
		RunService.Heartbeat:Wait()
		RunService.Heartbeat:Wait()
		if active then
			refreshTools()
			equipTools(true)
			recaptureDropped()
			stabilizeHandles()
			beginBurst()
		end
	end)
end)

if player.Character then bindCharacter(player.Character) end
player.CharacterAdded:Connect(bindCharacter)

