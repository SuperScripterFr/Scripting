-- ⚡ COBALT COMBAT CORE (USE TOOLS + AURA + UI)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")

local lp = Players.LocalPlayer

--========================================
-- ⚙️ CONFIG
--========================================
local RATE = 75
local INTERVAL = 1 / RATE

local AURA_SIZE = Vector3.new(30,30,30)
local TOUCH_BURST = 2

local TOGGLE_KEY = Enum.KeyCode.Q

local enabled = false
local lastFire = 0

local auraParams = OverlapParams.new()
auraParams.FilterType = Enum.RaycastFilterType.Include

--========================================
-- 🎨 THEME (COBALT GLASS)
--========================================
local Theme = {
	Accent = Color3.fromRGB(40,120,255),
	Glass  = Color3.fromRGB(10,15,35),
	Text   = Color3.fromRGB(200,220,255)
}

local ANIM = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function round(i,r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 14)
	c.Parent = i
end

local function stroke(i, t)
	local s = Instance.new("UIStroke")
	s.Color = Theme.Accent
	s.Thickness = t or 1.5
	s.Transparency = 0.25
	s.Parent = i
end

--========================================
-- 🎯 TARGET BUILDER
--========================================
local function getTargets()

	local char = lp.Character
	if not char then return {} end

	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return {} end

	local t = {}

	for _,p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			if hrp and (hrp.Position - root.Position).Magnitude <= 40 then
				table.insert(t, p.Character)
			end
		end
	end

	return t
end

--========================================
-- ⚡ TOOL EXECUTION
--========================================
local function processTool(tool, targets)

	if tool.Parent ~= lp.Character then
		tool.Parent = lp.Character
	end

	pcall(tool.Activate, tool)

	local touch = tool:FindFirstChildWhichIsA("TouchTransmitter", true)
	touch = touch and touch.Parent

	local remote = tool:FindFirstChild("FightEvent")

	if remote then
		pcall(function()
			remote:FireServer()
		end)
	end

	if touch and #targets > 0 then

		auraParams.FilterDescendantsInstances = targets

		local parts = workspace:GetPartBoundsInBox(
			touch.CFrame,
			touch.Size + AURA_SIZE,
			auraParams
		)

		for _,p in ipairs(parts) do
			for i = 1, TOUCH_BURST do
				pcall(firetouchinterest, touch, p, 0)
				pcall(firetouchinterest, touch, p, 1)
			end
		end
	end
end

--========================================
-- ⚡ ENGINE
--========================================
RunService.PreSimulation:Connect(function()

	if not enabled then return end

	local now = os.clock()
	if now - lastFire < INTERVAL then return end
	lastFire = now

	local char = lp.Character
	if not char then return end

	local targets = getTargets()
	if #targets == 0 then return end

	for _,tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then
			processTool(tool, targets)
		end
	end

	RunService.PostSimulation:Wait()

	for _,tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then
			processTool(tool, targets)
		end
	end

end)

--========================================
-- ⚡ SPAWN BURST
--========================================
lp.CharacterAdded:Connect(function(char)

	task.spawn(function()

		local start = os.clock()

		while os.clock() - start < 0.25 do

			if not enabled then break end

			local targets = getTargets()

			for _,tool in ipairs(char:GetChildren()) do
				if tool:IsA("Tool") then
					processTool(tool, targets)
				end
			end

			RunService.PreSimulation:Wait()
		end

	end)
end)

--========================================
-- 🧊 UI TOGGLE
--========================================
local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "CobaltCombatUI"
gui.ResetOnSpawn = false

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.fromOffset(180, 60)
btn.Position = UDim2.fromScale(0.98, 0.6)
btn.AnchorPoint = Vector2.new(1,0.5)
btn.Text = "COMBAT: OFF"
btn.Font = Enum.Font.GothamBold
btn.TextSize = 15
btn.TextColor3 = Theme.Text
btn.BackgroundColor3 = Theme.Glass
btn.BackgroundTransparency = 0.1
btn.Active = true
btn.Draggable = true
btn.AutoButtonColor = false

round(btn,16)
stroke(btn,2)

local glow = Instance.new("UIStroke", btn)
glow.Color = Theme.Accent
glow.Thickness = 2
glow.Transparency = 0.6

--========================================
-- 🎛️ STATE CONTROL
--========================================
local function updateUI()
	btn.Text = enabled and "COMBAT: ON" or "COMBAT: OFF"

	TweenService:Create(glow, ANIM, {
		Transparency = enabled and 0.2 or 0.6
	}):Play()
end

local function setState(state)
	enabled = state
	updateUI()
end

btn.MouseButton1Click:Connect(function()
	setState(not enabled)
end)

UIS.InputBegan:Connect(function(i,g)
	if not g and i.KeyCode == TOGGLE_KEY then
		setState(not enabled)
	end
end)

--========================================
-- ✨ HOVER EFFECT
--========================================
btn.MouseEnter:Connect(function()
	TweenService:Create(btn, ANIM, {
		Size = UDim2.fromOffset(190, 66)
	}):Play()
end)

btn.MouseLeave:Connect(function()
	TweenService:Create(btn, ANIM, {
		Size = UDim2.fromOffset(180, 60)
	}):Play()
end)

updateUI()
print("⚡ Cobalt Combat Core + UI Loaded")
