----------------------------------------------------------------
-- TOGGLE LOGIC
----------------------------------------------------------------
local function updateText()
	toggle.Text = active and "USE TOOLS: ON" or "USE TOOLS: OFF"
end

local function setState(state)
	active = state
	updateText()

	if active then
		equipTools()
	else
		unequipTools()
	end
end

toggle.MouseButton1Click:Connect(function()
	setState(not active)
end)

UIS.InputBegan:Connect(function(i,g)
	if not g and i.KeyCode == Enum.KeyCode.E then
		setState(not active)
	end
end)

----------------------------------------------------------------
-- RESPAWN SAFETY
----------------------------------------------------------------
task.spawn(function()

	local lastChar = nil

	while true do
		local char = player.Character

		if char and char ~= lastChar then
			lastChar = char

			if active then
				task.spawn(function()
					local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart")

					-- ⚡ EQUIP IMMEDIATELY (EARLIER THAN CharacterAdded)
					equipTools()

					-- ⚡ MICRO BURST INSTANT
					for i = 1, 2 do
						activateTools()
						RunService.Heartbeat:Wait()
					end
				end)
			end
		end

		RunService.Heartbeat:Wait()
	end

end)

player.CharacterAdded:Connect(function(char)
	if not active then return end

	task.spawn(function()

		local root = char:WaitForChild("HumanoidRootPart")

		local start = os.clock()

		-- ⚡ FORCE EQUIP WINDOW (VERY IMPORTANT)
		while os.clock() - start < 0.3 do
			equipTools()
			RunService.Heartbeat:Wait()
		end

		-- ⚡ FINAL BURST
		for i = 1, 3 do
			activateTools()
			RunService.Heartbeat:Wait()
		end

	end)
end)

updateText()
print("[RTX] Use Tools initialized")
