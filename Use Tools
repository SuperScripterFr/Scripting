------------------------------------------------------------
-- SERVICES
------------------------------------------------------------

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

------------------------------------------------------------
-- THEME
------------------------------------------------------------

local Theme = {
	Accent = Color3.fromRGB(0,0,0),
	Glass  = Color3.fromRGB(100,0,0),
	Text   = Color3.fromRGB(255,0,0),
	Stroke = Color3.fromRGB(255,0,0)
}

local ANIM = TweenInfo.new(
	0.35,
	Enum.EasingStyle.Quart,
	Enum.EasingDirection.Out
)

local function round(i,r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,r or 14)
	c.Parent = i
end

local function stroke(i,thick)
	local s = Instance.new("UIStroke")
	s.Color = Theme.Stroke
	s.Thickness = thick or 4
	s.Parent = i
end

------------------------------------------------------------
-- CONFIG
------------------------------------------------------------

local APS = 75
local PULSE_INTERVAL = 1 / APS

local RESPAWN_BURST_TIME = 1.0
local TOUCH_ASSIST_RANGE = 14
local TOUCH_ASSIST_BURST = 1

------------------------------------------------------------
-- STATE
------------------------------------------------------------

local active = false
local toolsCache = {}

local currentCharacter
local currentRoot

local lastPulse = 0
local burstActive = false

------------------------------------------------------------
-- CHARACTER TRACKING
------------------------------------------------------------

local function bindCharacter(char)

	currentCharacter = char
	currentRoot = nil

	if not char then
		return
	end

	currentRoot = char:FindFirstChild("HumanoidRootPart")

		if not currentRoot then
		task.spawn(function()

			local hrp = char:WaitForChild("HumanoidRootPart",5)

			if currentCharacter == char then
				currentRoot = hrp
			end
		end)
	end
end

if player.Character then
	bindCharacter(player.Character)
end

player.CharacterAdded:Connect(bindCharacter)

------------------------------------------------------------
-- TOOL CACHE
------------------------------------------------------------

local function refreshTools()

	table.clear(toolsCache)

	local char = currentCharacter

	if not char then
		return
	end

	for _,obj in ipairs(char:GetChildren()) do
		if obj:IsA("Tool") then
			table.insert(toolsCache,obj)
		end
	end
end

------------------------------------------------------------
-- EQUIP
------------------------------------------------------------

local lastEquipCheck = 0
local EQUIP_INTERVAL = 0.08

local function equipTools(force)

	local now = os.clock()

	-- ⚡ throttle normal checks
	if not force and now - lastEquipCheck < EQUIP_INTERVAL then
		return
	end

	lastEquipCheck = now

	local char = currentCharacter
	local backpack = player:FindFirstChildOfClass("Backpack")

	if not char or not backpack then
		return
	end

	local changed = false

	--------------------------------------------------------
	-- EQUIP EVERYTHING
	--------------------------------------------------------

	for _,tool in ipairs(backpack:GetChildren()) do

		if tool:IsA("Tool") then
          tool.Parent = char
          changed = true
	   end
	end

	--------------------------------------------------------
	-- REFRESH CACHE ONLY IF NEEDED
	--------------------------------------------------------

	if changed then
		refreshTools()
	end
end

------------------------------------------------------------
-- UNEQUIP
------------------------------------------------------------

local function unequipTools()

	local char = currentCharacter
	local backpack = player:FindFirstChildOfClass("Backpack")

	if not char or not backpack then
		return
	end

	for _,tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then
			tool.Parent = backpack
		end
	end

	table.clear(toolsCache)
end

------------------------------------------------------------
-- TOUCH HELPER
------------------------------------------------------------

local function getTouchPart(tool)

	for _,obj in ipairs(tool:GetDescendants()) do
		if obj:IsA("TouchTransmitter") then
			local parent = obj.Parent

			if parent and parent:IsA("BasePart") then
				return parent
			end
		end
	end
end

local function getClosestTarget()

	local myRoot = currentRoot

	if not myRoot then
		return nil
	end

	local closest
	local bestDist = TOUCH_ASSIST_RANGE

	for _,plr in ipairs(Players:GetPlayers()) do

		if plr ~= player then

			local char = plr.Character

			if char then

				local hum = char:FindFirstChild("Humanoid")
				local root = char:FindFirstChild("HumanoidRootPart")

				if hum and root and hum.Health > 0 then

					local dist = (root.Position - myRoot.Position).Magnitude

					if dist < bestDist then
						bestDist = dist
						closest = root
					end
				end
			end
		end
	end

	return closest
end

local function touchAssist()

	local target = getClosestTarget()

	if not target then
		return
	end

	for i = 1,#toolsCache do

		local tool = toolsCache[i]

		if tool and tool.Parent then

			local touchPart = getTouchPart(tool)

			if touchPart then

				for _ = 1, TOUCH_ASSIST_BURST do
					firetouchinterest(touchPart,target,0)
					firetouchinterest(touchPart,target,1)
				end
			end
		end
	end
end

------------------------------------------------------------
-- ACTIVATE
------------------------------------------------------------

local function activateTools()

	for i = 1,#toolsCache do

		local tool = toolsCache[i]

		if tool and tool.Parent then
			pcall(tool.Activate,tool)
		end
	end
end

------------------------------------------------------------
-- DAMAGE CORE
------------------------------------------------------------

local function damagePulse()

	activateTools()

	touchAssist()
end

------------------------------------------------------------
-- RESPAWN BURST
------------------------------------------------------------

local function beginBurst()

	if burstActive then
		return
	end

	burstActive = true

	task.spawn(function()

		local t0 = os.clock()

		-- ⚡ equip instantly
		equipTools(true)

		-- ⚡ stabilize replication
		RunService.Heartbeat:Wait()

		while active and os.clock() - t0 < RESPAWN_BURST_TIME do

			equipTools()
			damagePulse()

			RunService.Heartbeat:Wait()
		end

		burstActive = false
	end)
end

------------------------------------------------------------
-- MAIN ENGINE
------------------------------------------------------------

RunService.PreSimulation:Connect(function()

	if not active then
		return
	end

	local now = os.clock()

	if now - lastPulse < PULSE_INTERVAL then
		return
	end

	lastPulse = now

	equipTools()
	damagePulse()
end)

------------------------------------------------------------
-- RESPAWN
------------------------------------------------------------

player.CharacterAdded:Connect(function()

	if not active then
		return
	end

	beginBurst()
end)

------------------------------------------------------------
-- UI
------------------------------------------------------------

