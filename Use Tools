local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

-- ============ RE-RUN GUARD ============
if getgenv().SPT_Loaded and getgenv().SPT_Loaded["Use Tools"] then
	print("⚡ Use Tools already loaded.")
	return
end
getgenv().SPT_Loaded = getgenv().SPT_Loaded or {}
getgenv().SPT_Loaded["Use Tools"] = true

-- ============ THEME ============
local Theme = {
	Accent = Color3.fromRGB(0, 0, 0),
	Glass  = Color3.fromRGB(100, 0, 0),
	Text   = Color3.fromRGB(255, 0, 0),
	Stroke = Color3.fromRGB(255, 0, 0),
}

local ANIM = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function round(i, r)
