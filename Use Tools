-- ⚡ QUANTUM MULTITOOL ENGINE

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

-- CONFIG
local ACTIVATIONS_PER_SECOND = 50
local EQUIP_REFRESH = 0.12
local BURST_PER_PULSE = 1

-- STATE
local active = false
local pulseAccum = 0
local equipAccum = 0
local pulseInterval = 2 / ACTIVATIONS_PER_SECOND

--==================================================
-- TOOL CONTROL
--==================================================

local function equipAll()
	local char = player.Character
	local bp = player.Backpack
	if not char or not bp then return end

	for _,t in ipairs(bp:GetChildren()) do
		if t:IsA("Tool") then
			t.Parent = char
		end
	end
end

local function unequipAll()
	local char = player.Character
	local bp = player.Backpack
	if not char or not bp then return end

	for _,t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			t.Parent = bp
		end
	end
end

local function pulseActivate()
	local char = player.Character
	if not char then return end

	for _,t in ipairs(char:GetChildren()) do
		if t:IsA("Tool") then
			for i=1,BURST_PER_PULSE do
				pcall(t.Activate,t)
			end
		end
	end
end

--==================================================
-- ENGINE
--==================================================

RunService.Heartbeat:Connect(function(dt)

	if not active then return end

	equipAccum += dt
	if equipAccum >= EQUIP_REFRESH then
		equipAccum = 0
		equipAll()
	end

	pulseAccum += dt
	while pulseAccum >= pulseInterval do
		pulseAccum -= pulseInterval
		pulseActivate()
	end

end)

--==================================================
-- UI
--==================================================

local gui = Instance.new("ScreenGui",game.CoreGui)
gui.ResetOnSpawn = false

local btn = Instance.new("TextButton",gui)
btn.Size = UDim2.fromOffset(120,42)
btn.Position = UDim2.new(1,-140,1,-80)
btn.BackgroundColor3 = Color3.fromRGB(20,20,35)
btn.TextColor3 = Color3.fromRGB(0,255,255)
btn.Text = "OVERDRIVE"
btn.Font = Enum.Font.GothamBold
btn.TextScaled = true
btn.Active = true
btn.Draggable = true

Instance.new("UICorner",btn).CornerRadius = UDim.new(0,10)
local stroke = Instance.new("UIStroke",btn)
stroke.Color = Color3.fromRGB(0,255,255)

local function setState(s)
	active = s
	btn.Text = active and "ACTIVE" or "OVERDRIVE"

	if active then
		equipAll()
	else
		unequipAll()
	end
end

btn.MouseButton1Click:Connect(function()
	setState(not active)
end)

UIS.InputBegan:Connect(function(i,g)
	if not g and i.KeyCode == Enum.KeyCode.E then
		setState(not active)
	end
end)

player.CharacterAdded:Connect(function()
	task.wait(.1)
	if active then
		equipAll()
	end
end)

print("⚡ Quantum MultiTool Ready")
