-- Initialize state variables
local attackEnabled = false
local player = game.Players.LocalPlayer
local attackingTools = {}

-- Store original wait() function
local originalWait = wait

-- Function to enable no cooldown
local function enableNoCooldown()
	if not _G.originalWait then
		_G.originalWait = wait
	end
	global_wait = hookfunction(wait, function()
		return task.wait(0)
	end)
end

-- Function to disable no cooldown
local function disableNoCooldown()
	if _G.originalWait then
		global_wait = hookfunction(wait, _G.originalWait)
	end
end

-- Function to toggle attack mode
local function toggleAttack()
	attackEnabled = not attackEnabled
	toolButton.Text = attackEnabled and "ON" or "OFF"
	toolButton.TextColor3 = attackEnabled and Color3.fromRGB(255, 80, 150) or Color3.fromRGB(100, 200, 255) -- Changes color to hot pink if ON

	if attackEnabled then
		enableNoCooldown()
	else
		disableNoCooldown()
		if player and player.Character then
			for _, tool in ipairs(player.Character:GetChildren()) do
				if tool:IsA("Tool") then
					tool.Parent = player.Backpack
				end
			end
		end
		attackingTools = {}
	end
end

-- Connect button click to toggle function
toolButton.MouseButton1Click:Connect(toggleAttack)

-- Function to equip and auto-activate tools
local function activateAllTools()
	if not attackEnabled then return end

	for _, tool in ipairs(player.Backpack:GetChildren()) do
		if tool:IsA("Tool") then
			if tool.Parent ~= player.Character then
				tool.Parent = player.Character
			end
			if not attackingTools[tool] then
				attackingTools[tool] = true
				task.spawn(function()
					while attackEnabled and tool.Parent == player.Character do
						pcall(function()
							tool:Activate()
						end)
						task.wait(0)
					end
					attackingTools[tool] = nil
				end)
			end
		end
	end
end

-- Auto-activate on RenderStepped
game:GetService("RunService").RenderStepped:Connect(function()
	if attackEnabled then
		activateAllTools()
	end
end)

-- Failsafe: Auto-requip unequipped tool
player.Character.ChildRemoved:Connect(function(tool)
	if attackEnabled and tool:IsA("Tool") then
		task.wait(0)
		if tool.Parent == player.Backpack then
			tool.Parent = player.Character
		end
	end
end)
